rules_version = '2';

// Reader feedback on published documents.
//
// THIS FILE IS THE ENTIRE SERVER.
//
// bluestreakhangar.com is a static site on GitHub Pages. There is no backend,
// no API layer, and no place to validate a request before it reaches the
// database. Everything a normal app would do in a route handler — authorize,
// validate types, cap lengths, reject fields the client has no business
// setting — has to happen here or it does not happen at all. Read every rule
// below as if it were an Express handler, because that is what it is.
//
// Threat model: this collection is writable by anyone who loads the guide. The
// controls, in order of how much weight they actually carry:
//
//   1. App Check (reCAPTCHA v3), enforced in the Firebase console, not here.
//      This is the ONLY control that bounds write VOLUME, and nothing in this
//      file substitutes for it. Anonymous auth is free to farm — a script can
//      mint thousands of uids — so auth alone stops nobody. Do not expose this
//      endpoint publicly with App Check enforcement off.
//   2. The deterministic document id (see ownsPath). One signed-in user gets
//      exactly ONE record per card, enforced by the path itself.
//
//      Be precise about what this does NOT do: it bounds duplicates per card,
//      not documents per user. `doc` and `block` are validated by shape, not
//      against the real card list, so one uid can create a record for every
//      (doc, block) pair it can spell. Measured on the emulator: 400 junk block
//      ids from a single uid, all accepted.
//
//      Validating block ids against the live card list would NOT fix that, and
//      was deliberately rejected. The counterfactual was measured too: 8 uids
//      across the 57 REAL card ids is 456 accepted rows, produced faster than
//      the junk-id run. An allowlist would buy a maintenance burden — every
//      analyzer regeneration becomes a rules deploy — in exchange for no
//      reduction in the volume an abuser can generate. Volume is App Check's
//      job; see control 1.
//   3. Field validation below: closed key set, enum membership, length caps,
//      and a charset on every field that has a structure worth enforcing.
//
// Reads are denied to readers, including to the author of a note. Feedback is
// a private inbox — it is never rendered back to any reader — and the client
// has no need to read: it keeps a local echo of its own answers in
// localStorage.
//
// The one exception is the maintainer allowlist in isAdmin(), which is what
// makes /inbox/ possible. That page is the only reader this collection has, and
// it can do exactly two things: read, and move `status` between 'new' and
// 'triaged'. It cannot edit a note, change a verdict, move a timestamp, or
// delete a record. Triage is not editorial control over what somebody wrote.

service cloud.firestore {
  match /databases/{database}/documents {

    // Whoever maintains the guide. A list, not a role system — there are two of
    // us, and an `admins` collection would be more machinery than people, plus
    // a document read on every single request.
    //
    // Allowlisted by email rather than uid because this repo is public and both
    // addresses are already in its git history as commit authors, so naming
    // them here publishes nothing that was private. An address you can read
    // beats an opaque uid you can't. Adding a maintainer whose address is NOT
    // already public is a different decision — use their uid for that.
    //
    // email_verified is not ceremony. Google sign-in always verifies, so the
    // check is free today, and it is what keeps this list from being defeated
    // by an unverified email claim if another provider is ever enabled.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
               'dimmonk@gmail.com',
               'sugarbehrr@gmail.com'
             ];
    }

    // feedback/{documentId}__{blockId}__{uid}
    //
    // documentId — the published document ("2026-ta-vote-guide")
    // blockId    — the card within it ("pay-levelset", "peer_benchmark")
    // uid        — the anonymous Firebase uid of whoever answered
    match /feedback/{feedbackId} {

      // Ties the path to the payload in one expression: a caller cannot write
      // to a path that disagrees with the doc/block/uid it claims. This is
      // also what enforces one-record-per-card-per-user — a second answer to
      // the same card resolves to the same path, so it is an update (validated
      // below) rather than a new row.
      //
      // Exact string equality, so the underscores inside some block ids
      // (peer_benchmark, union_accountability — 8 of the 57 live ids) are not
      // a parsing hazard: nothing ever splits this key back apart. Triage
      // reads the doc/block FIELDS, never the key.
      function ownsPath(data) {
        return request.auth != null
            && feedbackId == data.doc + '__' + data.block + '__' + request.auth.uid;
      }

      // A closed key set, checked in both directions. Anything unlisted is
      // rejected rather than silently stored — an open map on a public write
      // endpoint is how a feedback collection becomes someone else's free file
      // host.
      function hasExactKeys(data) {
        return data.keys().hasOnly(
                 ['doc', 'block', 'verdict', 'note', 'base',
                  'contentVersion', 'status', 'createdAt', 'updatedAt'])
            && data.keys().hasAll(
                 ['doc', 'block', 'verdict', 'note', 'base',
                  'contentVersion', 'status', 'createdAt', 'updatedAt']);
      }

      // matches() is a full-string match in Firestore rules, so these are
      // anchored without needing ^ and $.
      //
      // `doc` slugs are ours and stay hyphen-only. `block` has to tolerate the
      // underscores the analyzer already emits in marketCards[].id — verified
      // against all 57 live ids in assessment.data.js.
      function hasValidShape(data) {
        return data.doc is string
            && data.doc.matches('[a-z0-9][a-z0-9-]{0,63}')

            && data.block is string
            && data.block.matches('[a-z0-9][a-z0-9_-]{0,63}')

            // 'withdrawn' is how a reader takes an answer back. Deletes are
            // denied to the public, so retraction has to be a state on the
            // record rather than its absence — which also means we can tell
            // "never answered" apart from "answered, then thought better of
            // it". The report excludes withdrawn records from its counts.
            && data.verdict in ['clear', 'unclear', 'withdrawn']

            // Free text. Present but empty when the reader only tapped a
            // verdict. This cap is the only thing standing between this
            // collection and an unbounded public write.
            && data.note is string
            && data.note.size() <= 1000

            // Optional crew base ("CLT"). Empty string when not given.
            //
            // Charset, not just length. A size cap alone accepted a 4-character
            // base of "\n```" — enough to open a fenced block in the triage
            // report and swallow every card below it. The report escapes its
            // input now, but a field whose entire vocabulary is airport codes
            // has no reason to accept a newline in the first place, and the
            // cheapest place to refuse it is the door.
            && data.base is string
            && data.base.matches('[A-Za-z0-9-]{0,8}')

            // ASSESSMENT.meta.version at the time of writing. Lets the triage
            // report flag notes written against text that has since been
            // regenerated, instead of silently misattributing them.
            //
            // Same reasoning: a version string is dotted digits, and "1\n<!--"
            // fit inside the old 24-char cap.
            && data.contentVersion is string
            && data.contentVersion.matches('[0-9A-Za-z._-]{0,24}');
      }

      // Client clocks lie, and on this audience they lie a lot — phones held
      // in the wrong timezone, tablets left off for a month. Pin every stamp
      // to server time so the report's --since window means something.
      //
      // createdAt is frozen on amend: only updatedAt advances.
      function hasServerTime(data) {
        return data.createdAt == request.time
            && data.updatedAt == request.time;
      }

      allow create: if ownsPath(request.resource.data)
                    && hasExactKeys(request.resource.data)
                    && hasValidShape(request.resource.data)
                    && request.resource.data.status == 'new'
                    && hasServerTime(request.resource.data);

      // Amending an existing answer: the reader changed their mind, added a
      // note after tapping "Yes", or withdrew.
      //
      // The identity fields are frozen — you cannot repoint your record at a
      // different card, or at someone else's — and createdAt cannot move.
      //
      // status is deliberately NOT frozen, and is required to be 'new'. Two
      // reasons. Practically, the client cannot read its own record (reads are
      // denied), so it has no way to echo back a value triage may have
      // changed; requiring it to would break every amend made after we
      // triaged. Substantively, an edited note SHOULD return to the queue —
      // the content changed, so our previous read of it is stale. The inbox
      // orders by updatedAt, which makes re-opened items obvious.
      function isReaderAmend() {
        return ownsPath(request.resource.data)
            && hasExactKeys(request.resource.data)
            && hasValidShape(request.resource.data)
            && request.resource.data.doc == resource.data.doc
            && request.resource.data.block == resource.data.block
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == 'new'
            && request.resource.data.updatedAt == request.time;
      }

      // Marking a response done in /inbox/, and taking that back.
      //
      // Exactly one field may move, and only between two values. Everything a
      // reader wrote is immutable to us: we can say "handled", we cannot edit
      // what they said or when they said it.
      //
      // updatedAt in particular must NOT move. It means "when the reader last
      // touched this", and it is what the inbox orders by and what a --since
      // style window would filter on. If triage bumped it, reading the queue
      // would reshuffle the queue.
      //
      // Because the change is one reversible field, Undo needs no separate
      // rule: it is this same rule in the other direction.
      function isTriage() {
        return isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['new', 'triaged'];
      }

      allow update: if isReaderAmend() || isTriage();

      // Private inbox. Nothing written here is readable through the client SDK
      // by any reader, including the author of the note — only by a maintainer
      // on the allowlist above.
      //
      // Deletes stay denied to EVERYONE, maintainers included. A retraction is
      // already modelled as a state (verdict: 'withdrawn') so that "never
      // answered" stays distinguishable from "answered, then thought better of
      // it", and an abusive note is handled by marking it done rather than by
      // punching a hole in the record.
      allow read: if isAdmin();
      allow delete: if false;
    }

    // Everything else is closed. Adding a second document's feedback needs no
    // rule change: `doc` is just a different slug in the same collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
