---
import Icon from './Icon.astro';
import { richText } from '../lib/rich-text';
import { TIERS, TIER_ORDER, picksFor, alternatesFor, type TierCategory } from '../data/catalog';
import { bagFigures } from '../data/bag-figures';

/**
 * The tier ladder: one card, three columns, read left to right as a price
 * progression. A vertical row-per-pick layout was prototyped against this and
 * lost — side by side is the point, because $160 / $255 / $729 in one glance
 * IS the comparison this page exists to make.
 *
 * A CARD IS A TEASER, NOT A DESTINATION. Every pick has its own page carrying
 * the full six-figure ledger, so the card's job is to help you choose and hand
 * off: photo, name, price, the three figures that decide it, and the one
 * sentence that is the rating. The long prose and the buy bar live on the page.
 *
 * The three figures are the SAME three on every card — weight, capacity, sizer
 * clearance — which is what makes a column comparable down and across. They
 * are derived from published specs, never written per card, so the number here
 * and the number on the pick's page cannot disagree.
 */
interface Props {
  category: TierCategory;
  /** Browse variant: unused for now, kept so callers need not care. */
  compact?: boolean;
}

const { category } = Astro.props;

/** The three headline axes, in the order they decide a purchase. */
const HEADLINE = ['weight', 'fits', 'sizer'] as const;
---

<div class="tierscard">
  {
    TIER_ORDER.map((key) => {
      const tier = TIERS[key];
      const picks = picksFor(category, key);
      const alternates = alternatesFor(category, key);

      return (
        <div class="tiercol" data-tier={key} style={`--tc: ${tier.color}; --tfg: ${tier.fg};`}>
          <div class="tc-head">
            <div class="tbars">
              {[0, 1, 2].map((i) => (
                <b class:list={[i < tier.bars && 'on']} />
              ))}
            </div>
            <span class="tc-name">{tier.label}</span>
            <div class="tc-bracket">{tier.bracket}</div>
            <div class="tc-hl">{tier.explain.headline}</div>
          </div>

          <div class="tc-body">
            {picks.map((pick) => {
              const figures = bagFigures(pick.name, pick.price, pick.spec);
              const headline = HEADLINE.map((k) => figures.find((f) => f.key === k)!);

              return (
                <a class="pcard" href={`/crew-essentials/${pick.slug}/`}>
                  <div class="pc-shot">
                    {pick.image ? (
                      <img src={pick.image} alt={pick.imageAlt ?? pick.name} loading="lazy" />
                    ) : (
                      <Icon name={category.icon} />
                    )}
                  </div>

                  <div class="pc-head">
                    <h4 class="pc-name">{pick.name}</h4>
                    <span class="pc-price">${pick.price.toLocaleString('en-US')}</span>
                  </div>

                  {/* Same three axes on every card — the comparison currency. */}
                  <div class="pc-figs">
                    {headline.map((figure) => (
                      <div class="pc-fig">
                        <span class="pf-val">
                          {figure.value}
                          <i>{figure.unit}</i>
                        </span>
                        <span class="pf-ref">{figure.ref}</span>
                      </div>
                    ))}
                  </div>

                  <div class="pc-comp">
                    <Icon name="ph-scales" />
                    <span>{pick.compromise}</span>
                  </div>

                  <span class="pc-go">
                    See the pick <Icon name="ph-arrow-right" />
                  </span>
                </a>
              );
            })}

            {alternates.length > 0 && (
              <div class="tier-alts">
                <span class="ta-label">Also at this price — not reviewed</span>
                <ul>
                  {alternates.map((alt) => (
                    <li>
                      <a href={alt.url} target="_blank" rel="noopener sponsored">
                        {alt.name}
                      </a>{' '}
                      <span set:html={richText(alt.note)} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      );
    })
  }
</div>
