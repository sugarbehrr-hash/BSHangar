---
import Icon from './Icon.astro';
import { richText } from '../lib/rich-text';
import {
  TIERS,
  TIER_ORDER,
  picksFor,
  alternatesFor,
  sellerFor,
  type TierCategory,
} from '../data/catalog';

/**
 * The tier ladder: one card, three columns, read left to right as a price
 * progression. The bars step 1-2-3 like a signal meter.
 *
 * WHY THREE COLUMNS AND NOT A VERTICAL LIST. A row-per-pick layout was
 * prototyped against this one (public/_ladder-lab.html) and lost: putting the
 * tiers side by side is the entire point, because $160 / $255 / $729 in one
 * glance is the comparison the page exists to make. Stacking them turns a
 * comparison into a list.
 *
 * A column holds MORE THAN ONE pick — Cole's reviews gave two or three bags at
 * most price levels, and every one is a buy link. So the tier's identity and
 * price bracket live in a solid coloured header at the top of the column, and
 * each pick under it is a compact row.
 *
 * No column carries a selected or focused state, and no pick carries an
 * "approved" mark. Every pick here already cleared the same gate, so a badge
 * saying so would fire on every row and mean nothing — see the note under the
 * ladder, which says it once. The pick that is somebody's personal favourite
 * lives OUTSIDE this component, in the jumpseat slot.
 */
interface Props {
  category: TierCategory;
  /**
   * Browse-card variant: the longer prose is dropped, since the card is one
   * third of a grid row rather than the width of the page.
   */
  compact?: boolean;
}

const { category, compact = false } = Astro.props;
---

<div class="tierscard">
  {
    TIER_ORDER.map((key) => {
      const tier = TIERS[key];
      const picks = picksFor(category, key);
      const alternates = alternatesFor(category, key);

      return (
        <div class="tiercol" data-tier={key} style={`--tc: ${tier.color}; --tfg: ${tier.fg};`}>
          {/* Solid field in the tier's colour. A 3px keyline was tried first
              and you stop seeing it; the whole band is what makes the tier
              readable at a glance. */}
          <div class="tc-head">
            <div class="tbars">
              {[0, 1, 2].map((i) => (
                <b class:list={[i < tier.bars && 'on']} />
              ))}
            </div>
            <span class="tc-name">{tier.label}</span>
            <div class="tc-bracket">{tier.bracket}</div>
            <div class="tc-hl">{tier.explain.headline}</div>
          </div>

          <div class="tc-body">
            <ul class="tier-picks">
              {picks.map((pick) => {
                const seller = sellerFor(pick.url);

                return (
                  <li class="tier-pick">
                    {pick.image && (
                      <div class="tp-shot">
                        <img src={pick.image} alt={pick.imageAlt ?? pick.name} loading="lazy" />
                      </div>
                    )}

                    <div class="tp-id">
                      <div class="tp-head">
                        <h4 class="tp-name">
                          {pick.href ? <a href={pick.href}>{pick.name}</a> : pick.name}
                        </h4>
                        <span class="tp-price">${pick.price.toLocaleString('en-US')}</span>
                      </div>
                      <div class="tp-stat">{pick.stat}</div>
                    </div>

                    <div class="tp-det">
                      {!compact && <p class="tp-text">{pick.text}</p>}

                      <div class="tier-comp">
                        <Icon name="ph-scales" />
                        <div>
                          <b>Your compromise:</b> {pick.compromise}
                        </div>
                      </div>

                      <a
                        class="btn quiet sm tp-buy"
                        href={pick.url}
                        target="_blank"
                        rel={seller.affiliate ? 'noopener sponsored' : 'noopener'}
                      >
                        <Icon name={seller.icon} /> {seller.label}
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>

            {alternates.length > 0 && (
              <div class="tier-alts">
                <span class="ta-label">Also at this price — not reviewed</span>
                <ul>
                  {alternates.map((alt) => (
                    <li>
                      <a href={alt.url} target="_blank" rel="noopener sponsored">
                        {alt.name}
                      </a>{' '}
                      <span set:html={richText(alt.note)} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      );
    })
  }
</div>
