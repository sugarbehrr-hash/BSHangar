---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import GuideBody from './GuideBody.astro';
import GuideToc from './GuideToc.astro';
import SectionNav from './SectionNav.astro';
import { NAV } from '../data/site';
import type { Guide } from '../data/guides/types';

/**
 * The Article template — one shell for every long-form guide page.
 *
 * Before this existed, /commuting/ and the two contract guides each retyped
 * the same sequence (pagehead → callout → printable bar → body → provenance
 * footnote) with small accidental differences. The shell owns the sequence
 * and the TOC layout; a page contributes only its data, its SEO strings and
 * an optional callout via the slot.
 *
 * Provenance (translates / last revised) renders in the masthead where it can
 * actually be seen, not as a footnote afterthought.
 */
interface Props {
  guide: Guide;
  /** SEO title/description — required by BaseLayout on purpose, so passed through explicitly. */
  title: string;
  description: string;
  /** Standing disclaimer under the article, e.g. DISCLAIMER.contract. */
  disclaimer?: string;
  /**
   * "Keep reading" links at the end of the article. Defaults to the other
   * pages of this article's nav section, so section articles cross-link
   * without any page declaring it. Pass explicitly for articles whose nav
   * section has no children (commuting).
   */
  related?: { label: string; href: string }[];
}

const { guide, title, description, disclaimer, related } = Astro.props;

const printHref = `/print/${guide.slug}/`;
const provenance = [guide.meta.translates, guide.meta.revised].filter(Boolean);

const path = Astro.url.pathname;
const section = NAV.find(
  (item) => item.href !== '/' && item.children?.length && path.startsWith(item.href)
);

const relatedLinks =
  related ??
  (section
    ? [
        { label: `${section.label} overview`, href: section.href },
        ...(section.children ?? []).filter((child) => child.href !== path),
      ].filter((link) => link.href !== path)
    : []);
---

<BaseLayout title={title} description={description}>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-body">
        <div class="mh-eyebrow">{guide.eyebrow}</div>
        <h1 class="mh-title">{guide.title}</h1>
        <p class="mh-sub">{guide.intro}</p>
        {
          provenance.length > 0 && (
            <p class="mh-meta">
              {provenance.map((line) => (
                <span>{line}</span>
              ))}
            </p>
          )
        }
      </div>
    </div>
  </div>

  <section class="band cream">
    <div class="wrap">
      <SectionNav />
    </div>
    <div class="wrap article">
      <aside class="art-rail">
        <GuideToc guide={guide} />
      </aside>

      <div class="art-main">
        <slot />

        <div class="dlbar">
          <div class="txt">
            <b>Prefer it on paper?</b>
            <span>The same guide as a printable you can save or keep in your bag.</span>
          </div>
          <a class="btn btn-gold" href={printHref}>
            <Icon name="ph-printer" /> Printable
          </a>
        </div>

        <GuideBody guide={guide} />

        {disclaimer && <p class="art-disclaimer">{disclaimer}</p>}

        {
          relatedLinks.length > 0 && (
            <div class="art-next">
              <span class="kicker">Keep reading</span>
              <div class="art-next-row">
                {relatedLinks.map((link) => (
                  <a class="btn btn-navy btn-sm" href={link.href}>
                    {link.label} <Icon name="ph-arrow-right" />
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
