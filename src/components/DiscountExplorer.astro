---
import Icon from './Icon.astro';
import { venueCount, type Base } from '../data/bases';
import { baseFlyers } from '../data/resources';
import { slugify } from '../lib/slug';

/**
 * The crew-discount explorer.
 *
 * EVERY category's zones render on the one page, each tagged with its
 * category, and the pills filter them client-side — that is what the design
 * does. They were routes before (/clt/ and /clt/shop/), which split one screen
 * into two and made the pills navigation instead of a filter.
 *
 * The base switcher lives in the masthead (BaseTabs), since that one genuinely
 * does navigate between pages.
 *
 * Zones are native <details>, so open/closed needs no JavaScript. The script
 * here only does the category filter, the text filter and open/close all.
 */
interface Props {
  base: Base;
}

const { base } = Astro.props;

const flyers = baseFlyers[base.key] ?? [];
const firstCategory = base.categories[0]!;

/** Zone anchors are category-scoped, so "eat-atrium" and "shop-atrium" differ. */
const zoneId = (categoryKey: string, zoneName: string) =>
  `${categoryKey}-${slugify(zoneName)}`;
---

<div data-explorer>
  <div class="pillbar">
    <div class="pillrail">
      {
        base.categories.map((c) => (
          <button
            class="pill"
            type="button"
            data-cat={c.key}
            aria-current={c.key === firstCategory.key ? 'page' : undefined}
          >
            <Icon name={c.icon} />
            {c.label}
            <span class="count">{venueCount(c)}</span>
          </button>
        ))
      }
    </div>

    <div class="filter">
      <Icon name="ph-magnifying-glass" />
      <label class="sr-only" for="venue-filter">
        Filter {base.code} venues
      </label>
      <input
        type="search"
        id="venue-filter"
        data-filter
        placeholder="Filter by name…"
        autocomplete="off"
      />
    </div>
  </div>

  <div class="toolrow">
    <div class="count-label" data-count aria-live="polite">
      {venueCount(firstCategory)} spots · {firstCategory.zones.length} areas
    </div>
    <div class="quietbtns">
      <button class="txtbtn" type="button" data-open-all>Open all</button>
      <span class="tdot">·</span>
      <button class="txtbtn" type="button" data-close-all>Close all</button>
      {
        flyers.length > 0 && (
          <>
            <span class="tdot">·</span>
            <a class="txtbtn" href={flyers[0]!.href} data-flyer>
              Full list (PDF)
            </a>
          </>
        )
      }
    </div>
  </div>

  {
    base.categories.map((c) =>
      c.zones.map((zone) => (
        <details
          class="zone"
          data-zone
          data-cat={c.key}
          id={zoneId(c.key, zone.name)}
          hidden={c.key !== firstCategory.key}
        >
          <summary class="zhead">
            <span class="zbadge">{zone.badge}</span>
            <span class="ztitle">
              {zone.name}
              <span class="znote">{zone.note}</span>
            </span>
            <span class="zcount" data-zone-count>{zone.venues.length}</span>
            <Icon name="ph-caret-down" class="zchev" />
          </summary>
          <div class="zbody">
            {zone.venues.map((v) => (
              <div
                class="zrow"
                data-venue
                data-search={`${v.name} ${v.detail} ${v.highlight} ${zone.name}`.toLowerCase()}
              >
                <span class="zn">
                  {v.name}
                  <span class="zd">{v.detail}</span>
                </span>
                <span class="zs">{v.highlight}</span>
              </div>
            ))}
          </div>
        </details>
      ))
    )
  }

  <div class="zempty" data-empty hidden>
    <Icon name="ph-magnifying-glass" />
    <span>No spots match that search. Try a shorter term, or clear the filter.</span>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-explorer]');

  if (root) {
    const pills = [...root.querySelectorAll<HTMLButtonElement>('.pill[data-cat]')];
    const input = root.querySelector<HTMLInputElement>('[data-filter]');
    const zones = [...root.querySelectorAll<HTMLDetailsElement>('[data-zone]')];
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
    const flyer = root.querySelector<HTMLAnchorElement>('[data-flyer]');

    /** Flyer href per category, derived from the one the page rendered. */
    const flyerBase = flyer?.getAttribute('href')?.replace(/[^/]+\/$/, '') ?? '';

    let category = pills[0]?.dataset.cat ?? '';

    const render = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      let shown = 0;
      let areas = 0;

      for (const zone of zones) {
        const inCategory = zone.dataset.cat === category;
        let hits = 0;

        for (const row of zone.querySelectorAll<HTMLElement>('[data-venue]')) {
          const match = !q || (row.dataset.search ?? '').includes(q);
          row.hidden = !match;
          if (match) hits++;
        }

        // Out-of-category zones stay in the DOM (anchors keep working) but
        // never show; within the category, a search hides what doesn't match.
        zone.hidden = !inCategory || (q !== '' && hits === 0);
        if (!zone.hidden) {
          areas++;
          shown += hits;
          if (q) zone.open = hits > 0;
        }

        const badge = zone.querySelector<HTMLElement>('[data-zone-count]');
        if (badge) badge.textContent = String(q ? hits : zone.querySelectorAll('[data-venue]').length);
      }

      if (countEl) {
        countEl.textContent = q
          ? `${shown} match${shown === 1 ? '' : 'es'}`
          : `${shown} spots · ${areas} areas`;
      }
      if (emptyEl) emptyEl.hidden = !(q && areas === 0);
      if (flyer && flyerBase) flyer.href = `${flyerBase}${category}/`;

      for (const pill of pills) {
        if (pill.dataset.cat === category) pill.setAttribute('aria-current', 'page');
        else pill.removeAttribute('aria-current');
      }
    };

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        category = pill.dataset.cat ?? category;
        // Every zone closed, as the page loads: a terminal's worth of open
        // venue lists buries the other zones' headings, which are the thing
        // you are scanning for.
        for (const z of zones) z.open = false;
        render();
      });
    }

    input?.addEventListener('input', render);

    root.querySelector('[data-open-all]')?.addEventListener('click', () => {
      for (const z of zones) if (!z.hidden) z.open = true;
    });
    root.querySelector('[data-close-all]')?.addEventListener('click', () => {
      for (const z of zones) z.open = false;
    });

    render();
  }
</script>
