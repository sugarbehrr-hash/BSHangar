---
import Icon from './Icon.astro';
import { breadcrumbsFor } from '../lib/breadcrumbs';

/**
 * Visible breadcrumb trail, rendered by BaseLayout on every page at least two
 * levels deep (a top-level page is already located by the header nav).
 * The JSON-LD equivalent in StructuredData derives from the same
 * breadcrumbsFor, so the two can never tell different stories.
 */
interface Props {
  path: string;
  title: string;
}

const { path, title } = Astro.props;
const crumbs = breadcrumbsFor(path, title);

/** Home + section + child — anything shallower doesn't need a trail. */
const show = crumbs.length > 2;
---

{
  show && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="wrap">
        <ol>
          {crumbs.map((crumb, i) =>
            i === crumbs.length - 1 ? (
              <li aria-current="page">{crumb.label}</li>
            ) : (
              <li>
                <a href={crumb.href}>{crumb.label}</a>
                <Icon name="ph-caret-right" />
              </li>
            )
          )}
        </ol>
      </div>
    </nav>
  )
}
