---
import { bases } from '../data/bases';

/**
 * Base switcher for the discount pages, docked in the masthead.
 *
 * Uses the same .sectiontabs treatment as the section strip elsewhere: on a
 * dark surface, switching between sibling PAGES. The category switcher below
 * it is .pill — light surface, switching VIEWS within a page. Two jobs, two
 * looks, consistently applied; previously both were pills with different
 * active colours stacked inches apart.
 */
interface Props {
  current: string;
}

const { current } = Astro.props;
---

{/* `codes` — below 700px the four cities need 571px in a 375px viewport, so
    two bases sit off-screen behind a sideways scroll. The airport code is
    what people scan for anyway, and four of those share the row with room
    to spare. The tools strip has long labels and no code, so it keeps the
    scroller; the modifier is what keeps the two apart. */}
<nav class="sectiontabs codes" aria-label="Crew discount bases">
  {
    bases.map((base) => (
      <a
        href={`/crew-discounts/${base.key}/`}
        aria-current={base.key === current ? 'page' : undefined}
      >
        <span class="st-code">{base.code}</span>
        <span class="st-sub">{base.tabLabel}</span>
      </a>
    ))
  }
</nav>
