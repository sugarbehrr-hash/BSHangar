---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, FACEBOOK_GROUP } from '../data/site';
import { bases, venueCount } from '../data/bases';
import brandLogo from '../assets/brand-logo.svg';
import { products } from '../data/essentials';
import { commutingGuide } from '../data/guides/commuting';

/**
 * The real homepage, extracted from src/pages/index.astro so it can render at
 * two routes: `/` once PRELAUNCH is off, and the unlinked PREVIEW_PATH while
 * the curtain is up (see src/data/prelaunch.ts).
 *
 * Card sub-lines carry counts derived from the data they describe, so the
 * spot and pick totals can't go stale the way a hardcoded number would.
 */

const spotCount = bases.reduce(
  (total, base) => total + base.categories.reduce((n, c) => n + venueCount(c), 0),
  0
);

const doors = [
  {
    href: '/tools/',
    accent: 'var(--navy-700)',
    icon: 'ph-calculator',
    title: 'Paycheck & Tools',
    sub: '1 calculator · more coming',
    text: 'Check what your 5th or 20th should be before it lands — GTD, overages, per diem, 401(k), federal withholding and dues.',
    go: 'Check your numbers',
  },
  {
    href: '/commuting/',
    accent: 'var(--sky-700)',
    icon: 'ph-airplane-takeoff',
    title: 'Commuting',
    sub: `Guide · ${commutingGuide.sections.length} sections`,
    text: 'List, fly and report on time — plus exactly what protects you when the commute falls apart at 4am.',
    go: 'Read the guide',
  },
  {
    href: '/contract/',
    accent: 'var(--red-600)',
    icon: 'ph-scroll',
    title: 'Your Contract',
    sub: 'Hub · 2 field guides',
    text: 'Duty, rest, pay, scheduling and reserve rights — the CBA in plain language, each line sourced to its section.',
    go: 'Know your rights',
  },
  {
    href: '/crew-discounts/clt/',
    accent: 'var(--gold-600)',
    icon: 'ph-tag',
    title: 'Discounts',
    sub: `${bases.length} bases · ${spotCount} spots`,
    text: "Meals and shops by terminal at CLT, DCA, DFW and PHL. Filter by name when you've got twenty minutes.",
    go: 'Browse by base',
  },
  {
    href: '/crew-essentials/',
    accent: 'var(--success-600)',
    icon: 'ph-suitcase-rolling',
    title: 'Essentials',
    sub: `${products.length} vetted picks`,
    text: 'The bags, socks, chargers and care kit that survive the schedule. No sponsored fluff.',
    go: 'See the gear',
  },
];

const hashtags = [
  ['#FAQuestions', "anything you're unsure about, just ask."],
  ['#nonREVtips', 'commuting, listing & standby wisdom.'],
  ['#CrewDiscounts', 'deals, perks & where to save.'],
  ['#ContractualKnowledge', 'your rights, sourced to the CBA.'],
];

const steps = [
  ['We fly it first', 'Every guide comes from FAs living the schedule — not a policy binder.'],
  ['We write it plain', 'Real examples over legalese. If it needs a translation, we translate it.'],
  ['We keep it fresh', 'Spot something outdated? Post in the group and we update the master sheet.'],
  ['You just show up', 'Bookmark this, search it before a trip, and land ready.'],
];
---

<BaseLayout
  title="Blue Streak Hangar — PSA Flight Attendant Crew Hub"
  description={SITE.description}
  suffix={false}
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-grid home">
        <div class="mh-body">
          <div class="mh-eyebrow">{SITE.tagline}</div>
          <h1 class="mh-title">Look it up.<br /><span class="r">Get back to work.</span></h1>
          {/* The one thing the cards below can't say for themselves. The list
              of sections that used to lead this line is those cards, in words. */}
          <p class="mh-sub">
            Written by PSA flight attendants who fly the same schedule you do.
          </p>
          <div class="mh-actions">
            <a class="btn primary" href="#answers">
              <Icon name="ph-magnifying-glass" /> Find an answer
            </a>
            <a class="btn onnavy" href="#new-here">
              <Icon name="ph-hand-waving" /> New here?
            </a>
          </div>
        </div>

        <img
          class="mh-logo"
          src={brandLogo.src}
          alt=""
          width={brandLogo.width}
          height={brandLogo.height}
          loading="eager"
        />
      </div>
    </div>
  </div>

  <section class="band" id="answers">
    <div class="wrap">
      <div class="band-head">
        <span class="kicker">Five doors</span>
        <h2 class="h2">What are you looking up?</h2>
        <p class="lead">
          Each one is the whole reference, not a teaser — kept current so you don't have to scroll
          the group feed to find it again.
        </p>
      </div>

      <div class="grid three">
        {
          doors.map((door) => (
            <a class="card" href={door.href} style={`--accent: ${door.accent};`}>
              <div class="card-head">
                <span class="card-badge"><Icon name={door.icon} /></span>
                <div class="card-titles">
                  <h3 class="card-title">{door.title}</h3>
                  <div class="card-sub">{door.sub}</div>
                </div>
              </div>
              <p class="card-text">{door.text}</p>
              <span class="card-go">
                {door.go} <Icon name="ph-arrow-right" />
              </span>
            </a>
          ))
        }

        <a class="card inverse" href={FACEBOOK_GROUP} target="_blank" rel="noopener">
          <div class="card-head">
            <span class="card-badge"><Icon name="ph-chats-circle" /></span>
            <div class="card-titles">
              <h3 class="card-title">Ask the Group</h3>
              <div class="card-sub">Facebook · answered by crew</div>
            </div>
          </div>
          <p class="card-text">
            Not here? Post it. The hangar's full of senior FAs happy to help — and good questions
            become guides.
          </p>
          <span class="card-go" style="color: var(--gold-500);">
            Open Facebook <Icon name="ph-arrow-up-right" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="band paper" id="new-here">
    <div class="wrap">
      <div class="band-head">
        <span class="kicker">New here?</span>
        <h2 class="h2">Welcome aboard.</h2>
        <p class="lead">
          This is the all-in-one place PSA flight attendants turn to for the things we need every
          day. Here's how the group works.
        </p>
      </div>

      <div class="grid two">
        <div class="card flat" style="--accent: var(--navy-700);">
          <div class="card-head">
            <span class="card-badge"><Icon name="ph-users-three" /></span>
            <div class="card-titles">
              <h3 class="card-title">What this is</h3>
              <div class="card-sub">A community group, run by crew</div>
            </div>
          </div>
          <p class="card-text">
            A warm, no-drama space for PSA Airlines flight attendants. Whether you're brand new or
            a 20-year senior mama, you'll find people happy to help.
          </p>
          <ul class="rows" style="margin-top:14px;">
            <li><b>Everyone's welcome</b> — new hires and seasoned crew alike.</li>
            <li><b>Be kind &amp; respectful</b> — we lift each other up here.</li>
            <li><b>Real answers</b> from FAs who've actually been there.</li>
          </ul>
        </div>

        <div class="card flat" style="--accent: var(--sky-700);">
          <div class="card-head">
            <span class="card-badge"><Icon name="ph-hash" /></span>
            <div class="card-titles">
              <h3 class="card-title">The four hashtags</h3>
              <div class="card-sub">Post &amp; search by topic</div>
            </div>
          </div>
          <ul class="rows" style="margin-top:16px;">
            {hashtags.map(([tag, desc]) => <li><b>{tag}</b> — {desc}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <span class="kicker">How the hangar works</span>
        <h2 class="h2">One place. Always current.</h2>
      </div>

      <div class="grid four">
        {
          steps.map(([title, body], i) => (
            <div class="card flat">
              <div class="card-head">
                <span class="card-badge num">{i + 1}</span>
                <div class="card-titles">
                  <h3 class="card-title">{title}</h3>
                </div>
              </div>
              <p class="card-text" style="margin-top:14px;">{body}</p>
            </div>
          ))
        }
      </div>

      <div class="notice spaced">
        <Icon name="ph-lightbulb" />
        <div class="nt">
          <b>Tip:</b> the search box up top goes straight to a topic — try “non-rev”, “reserve”,
          “CLT meals”, or “compression socks”.
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
