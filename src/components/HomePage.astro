---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, FACEBOOK_GROUP } from '../data/site';
import airportScene from '../assets/airport-scene.jpg';

/**
 * The real homepage, extracted from src/pages/index.astro so it can render at
 * two routes: `/` once PRELAUNCH is off, and the unlinked PREVIEW_PATH while
 * the curtain is up (see src/data/prelaunch.ts).
 */

const cards = [
  {
    href: '/tools/',
    accent: 'var(--red-600)',
    icon: 'ph-calculator',
    title: 'Crew Tools',
    body: 'Calculators built from the group’s spreadsheets — see what your check should be before it lands.',
    cta: 'Check your numbers',
  },
  {
    href: '/commuting/',
    accent: 'var(--sky-700)',
    icon: 'ph-airplane-takeoff',
    title: 'Commuting & Non-Rev',
    body: 'List, fly, and report on time — plus your protections when a commute falls apart. The full field guide.',
    cta: 'Learn to commute',
  },
  {
    href: '/contract/',
    accent: 'var(--navy-700)',
    icon: 'ph-scroll',
    title: 'Your Contract',
    body: 'Duty, rest, pay, scheduling & reserve rights — the CBA translated into plain language you can actually use.',
    cta: 'Know your rights',
  },
  {
    href: '/crew-discounts/',
    accent: 'var(--gold-600)',
    icon: 'ph-tag',
    title: 'Crew Discounts',
    body: 'Meals, shops & perks by base — CLT, DCA, DFW & PHL. Flash your crew ID and save on the turn.',
    cta: 'Browse by base',
  },
  {
    href: '/crew-essentials/',
    accent: 'var(--success-600)',
    icon: 'ph-suitcase-rolling',
    title: 'Crew Essentials',
    body: 'The bags, socks, chargers & care kit that survive the schedule — vetted picks with links to buy.',
    cta: 'See the gear',
  },
  {
    href: FACEBOOK_GROUP,
    external: true,
    accent: 'var(--sky-500)',
    icon: 'ph-chats-circle',
    title: 'Ask the Group',
    body: "Something not covered here? The hangar's full of senior FAs happy to help. Post it — we've got you.",
    cta: 'Open Facebook',
  },
];

/** The four hashtags that organize the Facebook group, from the old New Here page. */
const hashtags = [
  ['#FAQuestions', "anything you're unsure about, just ask."],
  ['#nonREVtips', 'commuting, listing & standby wisdom.'],
  ['#CrewDiscounts', 'deals, perks & where to save.'],
  ['#ContractualKnowledge', 'your rights, sourced to the CBA.'],
];

const steps = [
  { n: 1, title: 'We fly it first', body: 'Every guide comes from FAs living the schedule — not a policy binder.' },
  { n: 2, title: 'We write it plain', body: 'Real examples over legalese. If it needs a translation, we translate it.' },
  { n: 3, title: 'We keep it fresh', body: 'Spot something outdated? Post in the group and we update the master sheet.' },
  { n: 4, title: 'You just show up', body: 'Bookmark this, search it before a trip, and land ready.' },
];
---

<BaseLayout
  title="Blue Streak Hangar — PSA Flight Attendant Crew Hub"
  description={SITE.description}
  suffix={false}
>
  <div class="hero">
    <div class="hero-a">
      <div class="inner">
        <div>
          <span class="kick"><Icon name="ph-airplane-tilt" /> {SITE.tagline}</span>
          <h1>Your home base for <span class="r">everything crew.</span></h1>
          <p class="lead">
            Non-rev commuting, your contract in plain language, crew discounts by base, and the
            gear that actually lasts — all in one place, from FAs who fly it every day.
          </p>
          <div class="cta">
            <a class="btn btn-red" href="#new-here"><Icon name="ph-hand-waving" /> Start here</a>
            <a class="btn btn-ghost" href="/crew-discounts/"><Icon name="ph-tag" /> Crew discounts</a>
          </div>
        </div>
        <div class="art">
          <div class="sun float"></div>
          <Image
            src={airportScene}
            alt="Flat illustration of a plane taking off at an airport"
            widths={[480, 760, 1040]}
            sizes="(max-width: 960px) 92vw, 500px"
            loading="eager"
          />
          <span class="pill">✈ Straight from the galley, not the corporate memo</span>
        </div>
      </div>
    </div>
  </div>

  <section class="band cream">
    <div class="wrap">
      <div>
        <span class="kicker">Find what you need</span>
        <h2 class="h2">Pick a hangar door.</h2>
        <p class="sectlead">
          Six shelves, everything labeled. Tap in — each one pulls from the guides we post in the
          group, kept current so you don't have to dig through the feed.
        </p>
      </div>

      <div class="catgrid">
        {
          cards.map((card) => (
            <a
              class="catcard"
              href={card.href}
              style={`--accent: ${card.accent};`}
              target={card.external ? '_blank' : undefined}
              rel={card.external ? 'noopener' : undefined}
            >
              <span class="cb"><Icon name={card.icon} /></span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <span class="go">
                {card.cta} <Icon name={card.external ? 'ph-arrow-up-right' : 'ph-arrow-right'} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band paper" id="new-here">
    <div class="wrap">
      <div>
        <span class="kicker">New here?</span>
        <h2 class="h2">Welcome aboard.</h2>
        <p class="sectlead">
          This is the all-in-one place PSA flight attendants turn to for the things we need every
          day — commuting, contract, discounts, and community. Here's how the group works.
        </p>
      </div>

      <div class="cols2" style="margin-top:30px;">
        <div class="infocard" style="--accent: var(--red-600);">
          <div class="ih">
            <span class="b"><Icon name="ph-users-three" /></span>
            <div>
              <h3>What this is</h3>
              <div class="ref">A community group, run by crew</div>
            </div>
          </div>
          <p class="ic-p">
            Blue Streak Hangar is a warm, no-drama space for PSA Airlines flight attendants.
            Whether you're brand new or a 20-year senior mama, you'll find people happy to help.
          </p>
          <ul class="flist" style="--accent: var(--red-600);">
            <li><b>Everyone's welcome</b> — new hires and seasoned crew alike.</li>
            <li><b>Be kind &amp; respectful</b> — we lift each other up here.</li>
            <li><b>Real answers</b> from FAs who've actually been there.</li>
          </ul>
        </div>

        <div class="infocard" style="--accent: var(--sky-700);">
          <div class="ih">
            <span class="b"><Icon name="ph-hash" /></span>
            <div>
              <h3>The four hashtags</h3>
              <div class="ref">Post &amp; search by topic</div>
            </div>
          </div>
          <ul class="flist" style="--accent: var(--sky-700);">
            {hashtags.map(([tag, desc]) => <li><b>{tag}</b> — {desc}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band cream">
    <div class="wrap">
      <div>
        <span class="kicker">How the hangar works</span>
        <h2 class="h2">One place. Always current.</h2>
      </div>

      <div class="steprow">
        {
          steps.map((step) => (
            <div class="stepc">
              <div class="n">{step.n}</div>
              <h4>{step.title}</h4>
              <p>{step.body}</p>
            </div>
          ))
        }
      </div>

      <div class="callout tip">
        <Icon name="ph-lightbulb" />
        <div class="ct">
          <b>Tip:</b> Use the search box up top to jump straight to a topic — try “non-rev”,
          “reserve”, “CLT meals”, or “compression socks”.
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
