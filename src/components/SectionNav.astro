---
import { NAV } from '../data/site';

/**
 * Tab strip for a nav section with children — "Overview · CBA Field Manual ·
 * Reserve Field Guide" on every page of the Contract section. Renders nothing
 * on pages whose section has no children, so templates can include it
 * unconditionally.
 *
 * Docked at the bottom of the navy masthead, so it uses the dark-surface
 * .sectiontabs treatment (white text + gold underline for current) rather
 * than the light .pill family used for switching views within a page. The
 * two can then never be confused for one another.
 */
const path = Astro.url.pathname;

const section = NAV.find(
  (item) => item.href !== '/' && item.children?.length && path.startsWith(item.href)
);

const tabs = section
  ? [{ label: 'Overview', href: section.href }, ...(section.children ?? [])]
  : [];
---

{
  section && (
    <nav class="sectiontabs" aria-label={`${section.label} section`}>
      {tabs.map((tab) => (
        <a href={tab.href} aria-current={path === tab.href ? 'page' : undefined}>
          {tab.label}
        </a>
      ))}
    </nav>
  )
}
