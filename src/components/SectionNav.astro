---
import { NAV } from '../data/site';

/**
 * Tab strip for a nav section with children — "Overview · CBA Field Manual ·
 * Reserve Field Guide" on every page of the Contract section. Renders nothing
 * on pages whose section has no children, so templates can include it
 * unconditionally.
 *
 * Reuses the .catbar/.cattab family the discounts explorer established:
 * same shape and size, active state by color only.
 */
const path = Astro.url.pathname;

const section = NAV.find(
  (item) => item.href !== '/' && item.children?.length && path.startsWith(item.href)
);

const tabs = section
  ? [{ label: 'Overview', href: section.href }, ...(section.children ?? [])]
  : [];
---

{
  section && (
    <nav class="catbar sectnav" aria-label={`${section.label} section`}>
      {tabs.map((tab) => (
        <a class="cattab" href={tab.href} aria-current={path === tab.href ? 'page' : undefined}>
          {tab.label}
        </a>
      ))}
    </nav>
  )
}
