---
import Icon from './Icon.astro';
import { richText } from '../lib/rich-text';
import type { LedgerFigure, LedgerIntro } from '../data/figure-ledger';

/**
 * The figure ledger and its detail panel.
 *
 * The rows are buttons rather than accordions on purpose: the ledger stays a
 * scannable set of numbers and the explanation loads into the panel beside it,
 * so the reader never loses their place among the figures.
 *
 * Height is locked by src/lib/panel-lock.ts — see that file for why.
 */
interface Props {
  figures: LedgerFigure[];
  intro: LedgerIntro;
}

const { figures, intro } = Astro.props;
---

<div class="figrow">
  <div class="numledger" role="group" aria-label="Key figures">
    {
      figures.map((figure) => (
        <button
          class="nlrow"
          type="button"
          data-row={figure.key}
          aria-pressed="false"
          aria-controls={`dp-${figure.key}`}
        >
          <div class="fig">
            {figure.value}
            {figure.unit && <span>{figure.unit}</span>}
          </div>
          <div>
            <div class="lb">{figure.label}</div>
            <div class="cap">{figure.caption}</div>
          </div>
          <div class="rf">{figure.ref}</div>
          <Icon name="ph-arrow-right" class="nlgo" />
        </button>
      ))
    }
  </div>

  <aside class="card flat detailpanel" data-panel style="--accent: var(--navy-700);">
    <div class="dp" data-row="intro">
      <div class="card-head">
        <span class="card-badge"><Icon name={intro.icon} /></span>
        <div class="card-titles">
          <h3 class="card-title">{intro.title}</h3>
          <div class="card-sub">{intro.sub}</div>
        </div>
      </div>
      {intro.paras.map((p) => <p set:html={richText(p)} />)}
      {
        intro.action && intro.actionIcon && (
          <div class="zdo">
            <Icon name={intro.actionIcon} />
            <div set:html={richText(intro.action)} />
          </div>
        )
      }
      <p class="dphint">
        <Icon name="ph-hand-tap" /> Tap a number for the detail
      </p>
    </div>

    {
      figures.map((figure) => (
        <div class="dp" id={`dp-${figure.key}`} data-row={figure.key} hidden>
          <div class="card-head">
            <span
              class="card-badge"
              style={figure.pane.accent && `--accent: ${figure.pane.accent};`}
            >
              <Icon name={figure.icon} />
            </span>
            <div class="card-titles">
              <h3 class="card-title">{figure.pane.title}</h3>
              <div class="card-sub">{figure.pane.sub}</div>
            </div>
          </div>
          {figure.pane.paras.map((p) => <p set:html={richText(p)} />)}
          {figure.pane.action && (
            <div class="zdo">
              <Icon name={figure.pane.actionIcon} />
              <div set:html={richText(figure.pane.action)} />
            </div>
          )}
        </div>
      ))
    }
  </aside>
</div>

<script>
  import { lockPanelHeight } from '../lib/panel-lock';

  const ledger = document.querySelector<HTMLElement>('.numledger');
  const panel = document.querySelector<HTMLElement>('[data-panel]');

  if (ledger && panel) {
    const rows = [...ledger.querySelectorAll<HTMLButtonElement>('.nlrow')];
    const panes = [...panel.querySelectorAll<HTMLElement>('.dp')];

    const show = (key: string) => {
      for (const pane of panes) pane.hidden = pane.dataset.row !== key;
      for (const row of rows) {
        row.setAttribute('aria-pressed', String(row.dataset.row === key));
      }
    };

    for (const row of rows) {
      row.addEventListener('click', () => {
        // Clicking the open row again returns to the intro pane.
        const isOpen = row.getAttribute('aria-pressed') === 'true';
        show(isOpen ? 'intro' : (row.dataset.row ?? 'intro'));
      });
    }

    lockPanelHeight(panel, panes);
  }
</script>
