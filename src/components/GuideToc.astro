---
import Icon from './Icon.astro';
import { slugify } from '../lib/slug';
import type { Guide } from '../data/guides/types';

/**
 * "On this page" navigation for a long-form guide, derived from the guide's
 * sections — the same array GuideBody renders — so the TOC cannot drift from
 * the content. (The print cover's `contents` list is a separate, hand-curated
 * artifact and deliberately not the source here.)
 *
 * Two presentations of one DOM: a sticky right-rail list on wide screens, and
 * a sticky collapsed jump-menu under the site header on narrow ones. The
 * toggle button only operates in the narrow layout; guide.css hides it on
 * desktop where the list is always open.
 */
interface Props {
  guide: Guide;
}

const { guide } = Astro.props;

const entries = guide.sections.map((section) => ({
  id: slugify(section.title),
  title: section.title,
  ref: section.ref,
}));
---

<nav class="toc" data-toc aria-label="On this page">
  <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="toc-list">
    <Icon name="ph-list-bullets" />
    <span>On this page</span>
    <Icon name="ph-caret-down" class="toc-chev" />
  </button>

  <div class="toc-head" aria-hidden="true">On this page</div>

  <ol class="toc-list" id="toc-list">
    {
      entries.map((entry) => (
        <li>
          <a href={`#${entry.id}`} data-toc-link={entry.id}>
            <span class="toc-title">{entry.title}</span>
            {entry.ref && <span class="toc-ref">{entry.ref}</span>}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');

  if (toc) {
    // Narrow-layout open/close. Desktop ignores this state entirely — the
    // list is display-forced open by the wide-viewport CSS.
    const toggle = toc.querySelector<HTMLButtonElement>('.toc-toggle');
    const setOpen = (open: boolean) => {
      toc.dataset.open = open ? '1' : '';
      toggle?.setAttribute('aria-expanded', String(open));
    };

    toggle?.addEventListener('click', () => setOpen(toc.dataset.open !== '1'));

    // Following a link should collapse the menu so it doesn't sit over the
    // section it just navigated to.
    for (const link of toc.querySelectorAll('a')) {
      link.addEventListener('click', () => setOpen(false));
    }

    // Scrollspy: the link whose section most recently crossed the reading
    // line gets aria-current. rootMargin pins the "reading line" to the top
    // third of the viewport so the highlight matches what you're looking at.
    const links = new Map<string, HTMLAnchorElement>();
    for (const link of toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')) {
      links.set(link.dataset.tocLink ?? '', link);
    }

    const sections = [...document.querySelectorAll<HTMLElement>('.gd-section[id]')].filter((s) =>
      links.has(s.id)
    );

    const setCurrent = (id: string) => {
      for (const [key, link] of links) {
        if (key === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    if (sections.length && 'IntersectionObserver' in window) {
      // Something is always highlighted: the first section until the spy has
      // observed anything (top of page, before any section crosses the line).
      setCurrent(sections[0]!.id);

      const visible = new Set<string>();

      const spy = new IntersectionObserver(
        (observed) => {
          for (const entry of observed) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          // Highlight the first document-order section in the reading zone;
          // if none is (short section scrolled past), keep the last highlight.
          const current = sections.find((s) => visible.has(s.id));
          if (current) setCurrent(current.id);
        },
        { rootMargin: '-15% 0px -55% 0px' }
      );

      for (const section of sections) spy.observe(section);
    }
  }
</script>
