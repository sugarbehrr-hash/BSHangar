---
import Icon from './Icon.astro';
import { JUMPSEAT, type TierCategory } from '../data/catalog';
import { bagFigures } from '../data/bag-figures';

/**
 * The jumpseat pick — what one named flight attendant actually flies.
 *
 * Deliberately NOT a fourth column on the ladder. The tiers are fare classes
 * sorted by price and every pick in them cleared "more than one of us said so";
 * this clears neither, so it sits outside the ladder rather than in it.
 *
 * TWO ZONES: .js-shot (the photo) and .js-story (everything that is
 * judgment, not data), in priority order — name/price, the same three
 * figures every ladder card shows (.pc-figs, completely unstyled here
 * beyond a max-width — same box, same size, same shape as every ladder
 * card, just width-capped instead of grid-sized — see system.css), the
 * rating, why there is no stamp (the credibility gate — the one thing that
 * makes a jumpseat pick different from every other pick on the page, so it
 * does not wait behind a story about carbon-fibre trolleys to be seen), the
 * descriptive paragraph, then the CTA.
 *
 * A fixed-width THIRD column, with the figures stretched to fill it, was
 * tried and looked broken: three short rows above a gap of dead space
 * running the rest of the card's height. A shrunk-to-fit chip cluster was
 * tried next and looked like a downgrade — smaller than the ladder cards'
 * own figures for no reason. Figures don't need a new shape at all; they
 * need the shape they already have, just placed inline instead of in a
 * column.
 *
 * Two things are structurally required regardless of layout: the crew
 * member behind it, and the reason the stamp is absent. Without those it is
 * an unearned recommendation, which is the failure this slot exists to
 * prevent.
 */
interface Props {
  category: TierCategory;
  /** Flags the card "This page" when the pick's own page is the one being read. */
  here?: boolean;
}

const { category, here = false } = Astro.props;
const pick = category.jumpseat;
const figures = bagFigures(pick.name, pick.price, pick.spec);
const HEADLINE = [
  { key: 'weight', axis: 'Weight' },
  { key: 'fits', axis: 'Capacity' },
  { key: 'sizer', axis: 'Sizer' },
] as const;
const headline = HEADLINE.map((h) => figures.find((f) => f.key === h.key)!);
---

<div class="jumpwrap" style={`--tc: ${JUMPSEAT.color}; --tfg: #fff;`}>
  <p class="jump-label">Not on the ladder</p>

  <div class="jumpseat">
    <div class="tc-head">
      <span class="tc-name">{JUMPSEAT.label}</span>
      <span class="js-by"><Icon name="ph-user" /> {pick.by}</span>
      <span class="js-kicker">{JUMPSEAT.explain.headline}</span>
      {here && <span class="js-here">This page</span>}
    </div>

    <div class="js-row">
      <div class="js-shot">
        {
          pick.image ? (
            <img src={pick.image} alt={pick.imageAlt ?? pick.name} loading="lazy" />
          ) : (
            <Icon name={category.icon} />
          )
        }
      </div>

      <div class="js-story">
        <div class="js-head">
          <h3 class="js-name">
            {pick.href && !here ? <a href={pick.href}>{pick.name}</a> : pick.name}
          </h3>
          <span class="js-price">${pick.price.toLocaleString('en-US')}</span>
        </div>

        <dl class="pc-figs">
          {
            headline.map((figure) => (
              <div class="pc-fig">
                <dd class="pf-val">
                  {figure.value}
                  <i>{figure.unit}</i>
                </dd>
                <dd class="pf-ref">{figure.ref}</dd>
              </div>
            ))
          }
        </dl>

        {/* The rating. Same markup as every ladder card's compromise line. */}
        <div class="pc-comp js-rating">
          <Icon name="ph-scales" />
          <span>{pick.compromise}</span>
        </div>

        {/* The credibility gate — promoted above the paragraph. This is the
            one thing that makes a jumpseat pick different from every other
            pick on the page, so it does not wait behind a story about
            carbon-fibre trolleys to be seen. */}
        <div class="js-why">
          <Icon name="ph-info" />
          <div><b>Why there's no stamp.</b> {pick.why}</div>
        </div>

        <p class="js-text">{pick.text}</p>

        {
          !here && (
            <a class="btn quiet sm js-cta" href={`/crew-essentials/${pick.slug}/`}>
              <Icon name="ph-arrow-right" /> Read the full pick
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
