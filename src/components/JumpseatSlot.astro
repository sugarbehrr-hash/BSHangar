---
import Icon from './Icon.astro';
import { JUMPSEAT, type TierCategory } from '../data/catalog';
import { bagFigures } from '../data/bag-figures';

/**
 * The jumpseat pick — what one named flight attendant actually flies.
 *
 * Deliberately NOT a fourth column on the ladder. The tiers are fare classes
 * sorted by price and every pick in them cleared "more than one of us said so";
 * this clears neither, so it sits outside the ladder rather than in it.
 *
 * TWO ZONES: .js-shot (the photo) and .js-story (everything that is
 * judgment, not data), in priority order — name/price, the same three
 * figures every ladder card shows (as three side-by-side chips — see
 * .js-story .pc-figs in system.css — not the ladder card's single stacked
 * box, since this card has the width to spread them out), the descriptive
 * paragraph, why there is no stamp (the credibility gate — the one thing
 * that makes a jumpseat pick different from every other pick on the page),
 * then the CTA.
 *
 * Two things are structurally required regardless of layout: the crew
 * member behind it, and the reason the stamp is absent. Without those it is
 * an unearned recommendation, which is the failure this slot exists to
 * prevent.
 */
interface Props {
  category: TierCategory;
  /** Flags the card "This page" when the pick's own page is the one being read. */
  here?: boolean;
}

const { category, here = false } = Astro.props;
const pick = category.jumpseat;
const figures = bagFigures(pick.name, pick.price, pick.spec);
const HEADLINE = [
  { key: 'weight', axis: 'Weight' },
  { key: 'fits', axis: 'Capacity' },
  { key: 'sizer', axis: 'Sizer' },
] as const;
const headline = HEADLINE.map((h) => figures.find((f) => f.key === h.key)!);
---

<div class="jumpwrap" style={`--tc: ${JUMPSEAT.color}; --tfg: #fff;`}>
  <div class="jumpseat">
    <div class="tc-head">
      <span class="tc-name">{JUMPSEAT.label}</span>
      <span class="js-kicker">{JUMPSEAT.explain.headline}</span>
      {here && <span class="js-here">This page</span>}
    </div>

    <div class="js-row">
      <div class="js-shot">
        {
          pick.image ? (
            <img src={pick.image} alt={pick.imageAlt ?? pick.name} loading="lazy" />
          ) : (
            <Icon name={category.icon} />
          )
        }
      </div>

      <div class="js-story">
        <div class="js-head">
          <h3 class="js-name">
            {pick.href && !here ? <a href={pick.href}>{pick.name}</a> : pick.name}
          </h3>
          <span class="js-price">${pick.price.toLocaleString('en-US')}</span>
        </div>

        <dl class="pc-figs">
          {
            headline.map((figure) => (
              <div class="pc-fig">
                <dd class="pf-val">
                  {figure.value}
                  <i>{figure.unit}</i>
                </dd>
                <dd class="pf-ref">{figure.ref}</dd>
              </div>
            ))
          }
        </dl>

        <p class="js-text">{pick.text}</p>

        <div class="js-why">
          <Icon name="ph-info" />
          <div><b>Why there's no stamp.</b> {pick.why}</div>
        </div>

        {
          !here && (
            <a class="btn quiet sm js-cta" href={`/crew-essentials/${pick.slug}/`}>
              <Icon name="ph-arrow-right" /> Read the full pick
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
