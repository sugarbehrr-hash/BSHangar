---
import Icon from './Icon.astro';
import { richText } from '../lib/rich-text';
import { slugify } from '../lib/slug';
import type { GuideSection } from '../data/guides/types';

/**
 * One guide section. Extracted from GuideBody so a printable sheet can render
 * exactly one section per page while the web page renders them in sequence.
 *
 * The id makes every section a deep-link target — the TOC, search results and
 * the /contract/ summary cards all point at it. Print sheets carry the same
 * ids harmlessly (one section per sheet, still unique per document).
 *
 * data-accent is what carries the export's per-sheet colour identity: the band,
 * its badge, the bullet dots, the step numerals and the checklist bars all read
 * their colour off it (system.css §10). Nothing here hardcodes a colour.
 */
interface Props {
  section: GuideSection;
}

const { section } = Astro.props;

/**
 * The badge is a fixed square, so the ref sets its own type size: a section
 * number ("7") fills it, a letter-of-agreement tag ("LOA 2022") wraps small.
 */
const refSize = (ref: string) => (ref.length <= 2 ? 'lg' : ref.length <= 5 ? 'md' : 'sm');

/** Each tone's default glyph. A block may name its own instead. */
const NOTE_ICON = {
  alert: 'ph-warning',
  tip: 'ph-info',
  ok: 'ph-check-circle',
  caution: 'ph-warning-circle',
} as const;
---

<section class="gd-section" id={slugify(section.title)} data-accent={section.accent}>
  <div class="gd-band">
    {
      (section.ref || section.icon) && (
        <span class="gd-band-mark">
          {section.ref ? (
            <span class="n" data-size={refSize(section.ref)}>
              {section.ref}
            </span>
          ) : (
            <Icon name={section.icon!} />
          )}
        </span>
      )
    }
    <div class="gd-band-txt">
      {section.refLabel && <span class="gd-band-eyebrow">{section.refLabel}</span>}
      <h2 class="gd-h2">{section.title}</h2>
    </div>
  </div>

  {section.lead && <p class="gd-lead" set:html={richText(section.lead)} />}

  {
    section.blocks.map((block) => {
      if (block.kind === 'stat') {
        return (
          <div class="gd-stat">
            <span class="gd-stat-value">{block.value}</span>
            <span class="gd-stat-unit">{block.unit}</span>
            <span class="gd-stat-caption" set:html={richText(block.caption)} />
          </div>
        );
      }

      if (block.kind === 'note') {
        const tone = block.tone ?? 'tip';
        return (
          <div class:list={['gd-note', tone]}>
            <Icon name={block.icon ?? NOTE_ICON[tone]} class="gd-note-i" />
            <div class="gd-note-t" set:html={richText(block.text)} />
          </div>
        );
      }

      if (block.kind === 'prose') {
        return (
          <div class="gd-block">
            {block.title && (
              <h3 class="gd-h3">
                {block.title}
                {block.ref && <span class="gd-ref">{block.ref}</span>}
              </h3>
            )}
            <p class="gd-p" set:html={richText(block.text)} />
          </div>
        );
      }

      if (block.kind === 'steps') {
        return (
          <div class="gd-block">
            <h3 class="gd-h3">
              {block.title}
              {block.ref && <span class="gd-ref">{block.ref}</span>}
            </h3>
            {block.lead && <p class="gd-p" set:html={richText(block.lead)} />}
            <ol class="gd-steps">
              {block.steps.map((step) => (
                <li class:list={[step.icon && 'iconed']}>
                  <span class="gd-step-mark">{step.icon && <Icon name={step.icon} />}</span>
                  <span class="gd-step-txt">
                    <span class="gd-step-label">{step.label}</span>
                    <span class="gd-step-body" set:html={richText(step.body)} />
                  </span>
                </li>
              ))}
            </ol>
          </div>
        );
      }

      if (block.kind === 'rows') {
        return (
          <div class="gd-block">
            {block.title && (
              <h3 class="gd-h3">
                {block.title}
                {block.ref && <span class="gd-ref">{block.ref}</span>}
              </h3>
            )}
            {block.lead && <p class="gd-p" set:html={richText(block.lead)} />}
            <div class="gd-rows">
              {block.rows.map((row) => (
                <div class="gd-row" data-accent={row.accent}>
                  <span class="gd-row-badge">
                    <Icon name={row.icon} />
                  </span>
                  <span class="gd-row-txt">
                    <span class="gd-row-title">{row.title}</span>
                    <span class="gd-row-body" set:html={richText(row.body)} />
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      }

      if (block.kind === 'checklist') {
        return (
          <div class="gd-checklist">
            {block.groups.map((group) => (
              <div class:list={['gd-cl-group', group.alert && 'alert']}>
                <div class="gd-cl-head">
                  <span class="gd-cl-marker">{group.marker}</span>
                  <span class="gd-cl-title">{group.title}</span>
                  {group.when && <span class="gd-cl-when">{group.when}</span>}
                </div>
                <ul class="gd-cl-items">
                  {group.items.map((item) => (
                    <li set:html={richText(item)} />
                  ))}
                </ul>
              </div>
            ))}
          </div>
        );
      }

      if (block.kind === 'table') {
        return (
          <div class="gd-block">
            <h3 class="gd-h3">
              {block.title}
              {block.ref && <span class="gd-ref">{block.ref}</span>}
            </h3>
            {block.lead && <p class="gd-p" set:html={richText(block.lead)} />}
            <div class="gd-tbl">
              <table class="gd-table">
                <thead>
                  <tr>
                    <th>{block.head[0]}</th>
                    <th>{block.head[1]}</th>
                  </tr>
                </thead>
                <tbody>
                  {block.rows.map((row) => (
                    <tr>
                      <td set:html={richText(row[0])} />
                      <td set:html={richText(row[1])} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        );
      }

      return (
        <div class="gd-block">
          <h3 class="gd-h3">
            {block.title}
            {block.ref && <span class="gd-ref">{block.ref}</span>}
          </h3>
          {block.lead && <p class="gd-p" set:html={richText(block.lead)} />}
          <ul class="gd-list">
            {block.items.map((item) => (
              <li set:html={richText(item)} />
            ))}
          </ul>
        </div>
      );
    })
  }
</section>
