---
import Icon from './Icon.astro';
import RichText from './RichText.astro';

/**
 * The bordered card with an icon header and a bulleted list.
 * Used by /contract/ and the print artifacts, so the markup lives in one
 * place rather than being retyped per page as it was in the export.
 *
 * With `href` the card gains a footer link — the summary card's road into
 * the full reference it summarizes.
 */
interface Props {
  title: string;
  ref?: string;
  icon: string;
  accent: string;
  points: string[];
  href?: string;
  /** Footer link label; only rendered alongside `href`. */
  cta?: string;
}

const { title, ref, icon, accent, points, href, cta = 'Read the full section' } = Astro.props;
---

<div class="infocard" style={`--accent: ${accent};`}>
  <div class="ih">
    <span class="b"><Icon name={icon} /></span>
    <div>
      <h3>{title}</h3>
      {ref && <div class="ref">{ref}</div>}
    </div>
  </div>
  <ul class="flist" style={`--accent: ${accent};`}>
    {points.map((point) => <RichText as="li" text={point} />)}
  </ul>
  {
    href && (
      <a class="ic-go" href={href}>
        {cta} <Icon name="ph-arrow-right" />
      </a>
    )
  }
</div>
