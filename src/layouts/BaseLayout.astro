---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE } from '../data/site';
import { PRELAUNCH } from '../data/prelaunch';
import '../styles/global.css';

/**
 * The single page shell.
 *
 * `title` and `description` are REQUIRED, not optional with a fallback. Every
 * route has to state its own, which is the whole point: the export had one
 * <title> for the entire site and no description anywhere, because six pages
 * shared one document.
 */
interface Props {
  title: string;
  description: string;
  /** Appended to the site name. Pass false for the homepage. */
  suffix?: boolean;
}

const { title, description, suffix = true } = Astro.props;

const fullTitle = suffix ? `${title} — ${SITE.name}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const path = Astro.url.pathname;

/**
 * Per-route OG card, generated after the build by scripts/gen-og.mjs from this
 * page's own <title>. The slug rule here and the one in that script must agree;
 * both derive it from the pathname the same way.
 */
const ogSlug = path.replace(/^\/|\/$/g, '') === '' ? 'home' : path.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Pre-launch: keep every unreleased page out of search results, even the
        ones a crawler reaches despite robots.txt (see src/data/prelaunch.ts). */}
    {PRELAUNCH && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <StructuredData path={path} title={title} />
    {/* Page-specific head content — today only the Roller Pro's Product schema,
        which is about one product and so cannot live in the site-wide block. */}
    <slot name="head" />

    <!-- TODO Phase 9: replace the Phosphor CDN webfont with a self-hosted SVG
         sprite of only the icons this site uses, and self-host the four
         Google families that tokens/fonts.css currently @imports. Both are
         render-blocking third-party requests today. -->
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" is:inline></script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="site">
      <SiteHeader path={path} />
      <!-- data-pagefind-body scopes the search index to real page content, so
           the nav and footer (identical on every page) never become results. -->
      <main id="main" data-pagefind-body>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
