---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Notice from '../../components/Notice.astro';
import ToolTabs from '../../components/ToolTabs.astro';
import {
  EARNINGS,
  DEDUCTIONS,
  FILING,
  DEFAULT_FILING,
  DEFAULTS,
  DEFAULT_CHECK,
  bracketRange,
  type CheckDay,
} from '../../data/paycheck';
import { nextCheckOfType } from '../../data/pay-calendar';
import {
  renderCalendar,
  renderDayAnswer,
  renderCheckSummary,
} from '../../lib/pay-calendar-view';

/**
 * Crew Tools.
 *
 * The estimator's fields are server-rendered for the 5th (the default check)
 * so the page is readable and indexable without JS; the client script takes
 * over from there and re-renders the earnings list when the check changes.
 */
const shownOn = (on: CheckDay) => on === 'both' || on === DEFAULT_CHECK;
const initialEarnings = EARNINGS.filter((f) => shownOn(f.on));

/** Withholding-table amounts. Whole dollars print bare, cents print in full. */
const money = (n: number) =>
  '$' +
  n.toLocaleString('en-US', {
    minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
    maximumFractionDigits: 2,
  });

/**
 * The calendar's first paint. A static build can only know the BUILD date, so
 * these are a placeholder the client immediately replaces with the reader's
 * real today — the same trick the earnings list uses. Rendering it server-side
 * anyway keeps the panel readable without JS and visible to Pagefind.
 */
const buildToday = new Date();
const initialCalendar = renderCalendar({
  year: buildToday.getFullYear(),
  month: buildToday.getMonth(),
  today: buildToday,
  selected: null,
});
const initialDayAnswer = renderDayAnswer(null);
const initialSummary = renderCheckSummary(nextCheckOfType(buildToday, DEFAULT_CHECK));
---
<BaseLayout
  title="Paycheck Estimator"
  description="Crew calculators built from the group's spreadsheets. The Paycheck Estimator shows what your PSA check should be before it lands — GTD, overages, per diem, 401(k), federal withholding and dues."
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-body">
        <div class="mh-eyebrow">Crew calculators &amp; utilities</div>
        <h1 class="mh-title">Paycheck Estimator</h1>
        <p class="mh-sub">
          Built from the group's own spreadsheet. Five steps, top to bottom — the answer fills in
          by itself as you go. There's no calculate button.
        </p>
      </div>

      <ToolTabs />
    </div>
  </div>

  <section class="band tight">
    <div class="wrap">
      <div class="toollayout">
        <div class="stepstack accordion" id="stepstack">
          <section class="step open" data-step="1">
            <button class="step-head" type="button" aria-expanded="true" aria-controls="stepbody-1">
              <span class="step-badge">1</span>
              <span class="step-txt">
                <span class="step-title">How do you want to put your numbers in?</span>
                <span class="step-sub">Both get the same answer</span>
                <span class="step-resume" data-resume></span>
              </span>
              <Icon name="ph-caret-right" class="step-caret" />
            </button>
            <div class="step-body" id="stepbody-1">

            <div class="segtoggle" role="group" aria-label="How you want to put your numbers in" data-start-pick style="margin-top:16px;">
              <button
                type="button"
                data-start="upload"
                data-hint="Easiest. We read the file and fill in the boxes for you."
                aria-pressed="false"
                aria-controls="slipcard"
              >
                <Icon name="ph-file-pdf" /> Upload PDF
              </button>
              <button
                type="button"
                data-start="manual"
                data-hint="Copy from your Time Summary, one box at a time."
                aria-pressed="false"
              >
                <Icon name="ph-keyboard" /> Type it in
              </button>
            </div>
            <p class="segtoggle-hint" data-start-hint hidden></p>

            <div id="slipcard">
              <label class="dropzone" data-slip-drop for="slipFile">
                <Icon name="ph-upload-simple" />
                <span>
                  <strong>Choose a payslip PDF</strong> or drop one here — Workday › Payslip to Print
                </span>
              </label>
              <input type="file" id="slipFile" accept="application/pdf,.pdf" class="sr-only" />

              <p class="privacy">
                <Icon name="ph-lock-simple" />
                Read entirely on your own device. The file is never uploaded — this site has no server to send it to.
              </p>

              <div id="slipStatus" class="statusbox" role="status" hidden></div>
              <button type="button" id="slipForget" class="txtbtn" hidden>
                Forget my saved deductions
              </button>
            </div>
            </div>
          </section>

          <section class="step" data-step="2">
            <button class="step-head" type="button" aria-expanded="false" aria-controls="stepbody-2">
              <span class="step-badge">2</span>
              <span class="step-txt">
                <span class="step-title">Which paycheck are you checking?</span>
                <span class="step-sub">Tap a payday — or any day you flew</span>
                <span class="step-resume" data-resume></span>
              </span>
              <Icon name="ph-caret-right" class="step-caret" />
            </button>
            <div class="step-body" id="stepbody-2">
              <div class="paycal" id="paycal" set:html={initialCalendar} />
              <div id="paycalAnswer" set:html={initialDayAnswer} />
              <div id="checkSummary" set:html={initialSummary} />
              <Notice
                icon="ph-calendar-check"
                text="**Pay lands on the 5th and the 20th.** Around a weekend or a bank holiday it can arrive a day or two *early* — June 2026's 20th paid on the 18th, ahead of Juneteenth. Never later, so these dates are the ones to plan against."
              />
            </div>
          </section>

          <section class="step" data-step="3">
            <button class="step-head" type="button" aria-expanded="false" aria-controls="stepbody-3">
              <span class="step-badge">3</span>
              <span class="step-txt">
                <span class="step-title">Fill in your earnings</span>
                <span class="step-sub">From your Time Summary · leave anything you don't have at 0</span>
                <span class="step-resume" data-resume></span>
              </span>
              <Icon name="ph-caret-right" class="step-caret" />
            </button>
            <div class="step-body" id="stepbody-3">

            <div class="fieldgrid" id="earnBody" style="margin-top:16px;">
              {
                initialEarnings.map((f) => (
                  <div class="field">
                    <label>
                      {f.label}
                      {f.note && <small>{f.note}</small>}
                    </label>
                    <div class="money">
                      <input
                        type="number"
                        step="0.01"
                        min="0"
                        inputmode="decimal"
                        value={DEFAULTS[f.key]}
                        data-k={f.key}
                        aria-label={f.label}
                      />
                    </div>
                  </div>
                ))
              }
            </div>

            <button type="button" class="step-next" data-next="3">Next — deductions</button>
            </div>
          </section>

          <section class="step" data-step="4">
            <button class="step-head" type="button" aria-expanded="false" aria-controls="stepbody-4">
              <span class="step-badge">4</span>
              <span class="step-txt">
                <span class="step-title">Fill in your deductions</span>
                <span class="step-sub">From your last paystub · usually the same every check</span>
                <span class="step-resume" data-resume></span>
              </span>
              <Icon name="ph-caret-right" class="step-caret" />
            </button>
            <div class="step-body" id="stepbody-4">

            <div class="fieldgrid" id="dedBody" style="margin-top:16px;">
              {
                DEDUCTIONS.map((f) => (
                  <div class="field">
                    <label>
                      {f.label}
                      {f.note && <small>{f.note}</small>}
                    </label>
                    <div class:list={['money', f.percent && 'pct']}>
                      <input
                        type="number"
                        step="0.01"
                        min="0"
                        inputmode="decimal"
                        value={DEFAULTS[f.key]}
                        data-k={f.key}
                        aria-label={f.label}
                      />
                    </div>
                  </div>
                ))
              }
            </div>

            <label class="check">
              <input type="checkbox" id="ficaChk" checked />
              <span>
                <b>Estimate Social Security &amp; Medicare (7.65%)</b> — leave this on unless you've
                already included FICA in your post-tax number.
              </span>
            </label>

            <button type="button" class="step-next" data-next="4">Next — how you file</button>
            </div>
          </section>

          <section class="step" data-step="5">
            <button class="step-head" type="button" aria-expanded="false" aria-controls="stepbody-5">
              <span class="step-badge">5</span>
              <span class="step-txt">
                <span class="step-title">Pick how you file your taxes</span>
                <span class="step-sub">The box on your W-4, Step 1(c)</span>
                <span class="step-resume" data-resume></span>
              </span>
              <Icon name="ph-caret-right" class="step-caret" />
            </button>
            <div class="step-body" id="stepbody-5">

            <div class="segtoggle" role="tablist" aria-label="Filing status" data-filing-pick style="margin-top:16px;">
              {
                (['single', 'mfj', 'hoh'] as const).map((key) => (
                  <button
                    type="button"
                    role="tab"
                    data-filing={key}
                    aria-selected={key === DEFAULT_FILING}
                  >
                    {FILING[key].short}
                  </button>
                ))
              }
            </div>

            <p class="card-text" style="margin-top:14px; font-size:0.84375rem; color:var(--ink-500);">
              Married filing <em>separately</em>? Pick the first one — the IRS puts it in the same
              table as Single. That's their grouping, not ours.
            </p>

            <details class="reftable-wrap">
              <summary><Icon name="ph-caret-right" /> Federal withholding table (tap to view)</summary>
              <div class="reftable-body">
                <p style="margin:0 0 10px; font-size:0.8125rem; color:var(--ink-500);">
                  Showing the <strong id="filingName">{FILING[DEFAULT_FILING].label}</strong> table.
                </p>
                <div class="reftable-scroll">
                  <table class="reftable">
                    <thead>
                      <tr>
                        <th>Bracket (per check)</th>
                        <th>Add (+)</th>
                        <th>Multiply (×)</th>
                        <th>Subtract (−)</th>
                      </tr>
                    </thead>
                    <tbody id="brBody">
                      {
                        FILING[DEFAULT_FILING].brackets.map((b) => (
                          <tr>
                            <td>{bracketRange(b)}</td>
                            <td>{money(b.add)}</td>
                            <td>{b.pct}%</td>
                            <td>{money(b.sub)}</td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>

                <div class="field" style="border-top:none; padding-top:14px;">
                  <label>
                    Withholding allowance
                    <small>Standard deduction per check, set by the status above.</small>
                  </label>
                  <div class="money">
                    <input
                      type="number"
                      step="0.01"
                      min="0"
                      inputmode="decimal"
                      value={DEFAULTS.allow}
                      data-k="allow"
                      aria-label="Withholding allowance"
                    />
                  </div>
                </div>

                <Notice
                  tone="warn"
                  icon="ph-warning"
                  text="**Current as of the 2026 IRS tables.** Official 2026 Publication 15-T percentage-method values (Standard withholding, W-4 Step 2 unchecked), divided to per-semimonthly-check amounts. Reference only — switch tables by picking a filing status."
                />
              </div>
            </details>
            </div>
          </section>

          <div id="reconcile" class="card" hidden>
            <div class="card-head">
              <span class="card-badge"><Icon name="ph-scales" /></span>
              <div class="card-titles">
                <h3 class="card-title">Estimate vs. your actual payslip</h3>
                <div class="card-sub" id="reconcileFor"></div>
              </div>
            </div>
            <div id="reconcileRows" style="margin-top:16px;"></div>
            <p class="card-text" style="margin-top:12px; font-size:0.84375rem; color:var(--ink-500);">
              Small differences are normal — state and local tax, mid-period benefit changes, and
              rounding all move the number. A large gap on Federal Income Tax usually means the
              filing status you picked in Step 5 doesn't match your W-4.
            </p>
          </div>

          <Notice
            icon="ph-info"
            text="**How it works:** taxable earnings minus pre-tax deductions, 401(k) and your withholding allowance give federal taxable income for the check. The tool finds your bracket, figures the withholding, subtracts everything, then adds back non-taxable per diem. **It's an estimate, not a guarantee** — state/local tax varies by base and isn't included. Always verify against your paystub."
          />
        </div>

        <aside class="toolside">
          <div class="answer" aria-live="polite">
            <div class="answer-top">
              <span class="answer-lbl">Your answer</span>
              <span class="answer-lbl alt" id="checkLbl">Check of the 5th</span>
            </div>
            <div class="answer-net" id="netBig">$0.00</div>
            <div class="answer-sub">
              What should hit your bank. Updates by itself as you fill in the steps.
            </div>
            <div class="answer-break" id="breakBody"></div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* Phone-only. The sidebar answer is below five steps on a narrow screen,
      which is exactly where nobody looks while still filling them in. */}
  <div class="answerdock" id="answerDock">
    <button class="dock-bar" type="button" id="dockBar" aria-expanded="false" aria-controls="dockBody">
      <span>
        <span class="dock-lbl">Your answer</span>
        <span class="dock-date" id="dockDate"></span>
      </span>
      <span class="dock-net" id="dockNet">$0.00</span>
      <Icon name="ph-caret-up" class="dock-caret" />
    </button>
    <div class="dock-body" id="dockBody"></div>
  </div>
</BaseLayout>

<script>
  import {
    EARNINGS,
    FILING,
    DEFAULT_FILING,
    DEFAULT_CHECK,
    DEFAULTS,
    FICA_RATE,
    bracketRange,
    type FilingStatus,
  } from '../../data/paycheck';
  import {
    nextCheckOfType,
    checkOn,
    fromKey,
    dayKey,
    DAY_LABEL,
    MONTH_NAME,
    type PayCheck,
  } from '../../data/pay-calendar';
  import { createStepper } from '../../lib/stepper';
  import {
    renderCalendar,
    renderDayAnswer,
    renderCheckSummary,
  } from '../../lib/pay-calendar-view';

  const earnBody = document.getElementById('earnBody');
  const dedBody = document.getElementById('dedBody');
  const breakBody = document.getElementById('breakBody');
  const netBig = document.getElementById('netBig');
  const checkLbl = document.getElementById('checkLbl');
  const ficaChk = document.getElementById('ficaChk') as HTMLInputElement | null;
  const checkSummary = document.getElementById('checkSummary');
  const stack = document.getElementById('stepstack');

  if (earnBody && dedBody && breakBody && netBig && checkLbl && ficaChk && stack) {
    // Working copy of the user's own figures. The withholding brackets are not
    // in here on purpose: they are the published IRS values, displayed as text
    // and read straight from BRACKETS, so nothing on the page can alter them.
    const values: Record<string, number> = { ...DEFAULTS };
    let check: 5 | 20 = DEFAULT_CHECK;
    let fica = true;
    let filing: FilingStatus = DEFAULT_FILING;

    /**
     * The check being estimated, as a date rather than "the 5th". Step 2 sets
     * it by tapping a payday on the calendar; until then it is the next one of
     * the default kind, so the estimate is never waiting on a decision.
     */
    let picked: PayCheck = nextCheckOfType(new Date(), DEFAULT_CHECK);

    const stepper = createStepper(stack);

    // Set once the calendar is wired, so adopting a check from an import can
    // repaint the grid's banding without the calendar owning that decision.
    let calendarRedraw: (() => void) | null = null;

    const dockNet = document.getElementById('dockNet');
    const dockBody = document.getElementById('dockBody');
    const dockDate = document.getElementById('dockDate');
    const dock = document.getElementById('answerDock');
    const dockBar = document.getElementById('dockBar');

    dockBar?.addEventListener('click', () => {
      const open = dock?.classList.toggle('open') ?? false;
      dockBar.setAttribute('aria-expanded', String(open));
    });

    const money = (n: number) =>
      (n < 0 ? '-$' : '$') +
      Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    /** Rebuild the earnings list — which fields apply depends on the check. */
    function renderEarnings() {
      const fields = EARNINGS.filter((f) => f.on === 'both' || f.on === check);
      earnBody!.innerHTML = fields
        .map(
          (f) =>
            `<div class="field"><label>${f.label}` +
            (f.note ? `<small>${f.note}</small>` : '') +
            `</label><div class="money"><input type="number" step="0.01" min="0" ` +
            `inputmode="decimal" value="${values[f.key]}" data-k="${f.key}" ` +
            `aria-label="${f.label}"></div></div>`
        )
        .join('');
    }

    /**
     * The calculation on its own, with no DOM in it. Reconcile needs the same
     * figures the result card shows, and recomputing them a second way is how
     * the two drift apart.
     */
    function currentEstimate() {
      const on20 = check === 20;
      // The 20th pays 1 Half GTD, the 5th pays 2 Half GTD — see EARNINGS.
      const gtd = on20 ? values.gtd1 : values.gtd2;
      const over = on20 ? values.over : 0;
      const crew = on20 ? values.crew : 0;

      const taxableEarn = gtd + over + values.pdtax + crew + values.misc;
      const k401 = (gtd + over + values.pdtax) * (values.k401 / 100);
      const fedTaxable = taxableEarn - values.pretax - k401 - values.allow;

      let fedTax = 0;
      if (fedTaxable > 0) {
        const band = FILING[filing].brackets.find((b) => fedTaxable >= b.lo && fedTaxable < b.hi);
        if (band) fedTax = Math.max(0, band.add + (fedTaxable - band.sub) * (band.pct / 100));
      }

      const ficaAmt = fica ? Math.max(0, (taxableEarn - values.pretax) * FICA_RATE) : 0;
      const net =
        taxableEarn +
        values.pdno -
        values.pretax -
        k401 -
        values.posttax -
        fedTax -
        ficaAmt -
        values.dues;

      return { taxableEarn, k401, fedTax, fica: ficaAmt, net };
    }

    function calc() {
      const { taxableEarn, k401, fedTax, fica: ficaAmt, net } = currentEstimate();

      // Until an earning goes in, the total would open at a negative number
      // (the default deductions alone), which reads as "broken" to someone
      // still on step 1. Hold the answer until there is something to add up.
      if (taxableEarn === 0 && values.pdno === 0) {
        const empty =
          '<div class="answer-empty">Nothing to add up yet — your number appears here as soon as you fill in your earnings (Step 3).</div>';
        netBig!.textContent = '$0.00';
        breakBody!.innerHTML = empty;
        if (dockNet) dockNet.textContent = '$0.00';
        if (dockBody) dockBody.innerHTML = empty;
        return;
      }

      const rows: Array<[string, number, 'pos' | 'neg']> = [
        ['Taxable earnings', taxableEarn, 'pos'],
        ['Non-taxable per diem', values.pdno, 'pos'],
        ['Pre-tax deductions', -values.pretax, 'neg'],
        ['401(k) contribution', -k401, 'neg'],
        ['Federal income tax', -fedTax, 'neg'],
      ];
      if (ficaAmt > 0) rows.push(['Social Security & Medicare', -ficaAmt, 'neg']);
      rows.push(['Post-tax deductions', -values.posttax, 'neg'], ['Union dues', -values.dues, 'neg']);

      const breakdown =
        rows
          .filter(([label, amount]) => amount !== 0 || label === 'Taxable earnings')
          .map(
            ([label, amount, tone]) =>
              `<div class="brw"><span>${label}</span><span class="${tone}">${money(amount)}</span></div>`
          )
          .join('') +
        `<div class="brw total"><span>Expected net</span><span>${money(net)}</span></div>`;

      netBig!.textContent = money(net);
      breakBody!.innerHTML = breakdown;
      // The dock is the same answer, on a screen too narrow for the sidebar.
      if (dockNet) dockNet.textContent = money(net);
      if (dockBody) dockBody.innerHTML = breakdown;
    }

    /** One delegated handler covers the server-rendered fields and the
        re-rendered ones, so nothing has to be rebound after a toggle. */
    function onInput(event: Event) {
      const input = event.target as HTMLInputElement;
      if (!input.matches('input[data-k]')) return;

      const key = input.dataset.k;
      if (key) values[key] = parseFloat(input.value) || 0;
      calc();
      // Reopening a finished step and editing it must not leave the collapsed
      // summary quoting the old figures.
      refreshResumes();
    }

    document.addEventListener('input', onInput);

    /* ---------- Step summaries ---------- */

    /**
     * Steps 3 and 4 are free number entry, so there is no moment that means
     * "done" the way picking an option does. They get an explicit Next, which
     * is also the only honest way to let someone leave every field at zero.
     */
    const earnResume = () => {
      const total = EARNINGS.filter((f) => f.on === 'both' || f.on === check).reduce(
        (running, f) => running + (values[f.key] || 0),
        0
      );
      return total === 0 ? 'Nothing entered yet' : `${money(total)} in earnings`;
    };

    const dedResume = () =>
      `${money(values.pretax)} pre-tax · ${values.k401}% 401(k) · ${money(values.dues)} dues`;

    for (const button of stack.querySelectorAll<HTMLButtonElement>('button[data-next]')) {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.next);
        stepper.complete(index, index === 3 ? earnResume() : dedResume());
      });
    }

    // A finished step still has to tell the truth when its figures change —
    // an import fills every one of these behind a collapsed header.
    function refreshResumes() {
      if (stepper.isDone(3)) stepper.setResume(3, earnResume());
      if (stepper.isDone(4)) stepper.setResume(4, dedResume());
    }

    /** What a collapsed step 2 says it decided. */
    const checkResume = (c: PayCheck) =>
      `${DAY_LABEL(c.payDate)} · ${c.guaranteeHours} hrs` +
      (c.settles ? ` + ${MONTH_NAME(c.settles)}'s overages` : ', guarantee only');

    /**
     * Adopt a check. Called by the calendar and by payslip import, which also
     * knows which check it is looking at.
     *
     * `markDone` is off for the initial paint and for an import: neither is the
     * reader answering step 2, and marking it done would collapse a step they
     * never opened.
     */
    function setCheck(next: PayCheck, markDone = true) {
      picked = next;
      check = next.payDay;

      // Name the actual payday rather than "the 5th" — a date is something you
      // can plan around, which is the whole point of the calendar above it.
      checkLbl!.textContent = DAY_LABEL(next.payDate);
      if (dockDate) dockDate.textContent = DAY_LABEL(next.payDate);
      if (checkSummary) checkSummary.innerHTML = renderCheckSummary(next);

      renderEarnings();
      calc();
      calendarRedraw?.();

      if (markDone) stepper.complete(2, checkResume(next));
      else stepper.setResume(2, checkResume(next));
    }

    ficaChk.addEventListener('change', () => {
      fica = ficaChk.checked;
      calc();
    });

    /* ---------- Filing status ---------- */

    const FILING_KEY = 'bsh.paycheck.filing.v1';
    const filingPick = document.querySelector<HTMLElement>('[data-filing-pick]');
    const brBody = document.getElementById('brBody');
    const filingName = document.getElementById('filingName');

    /**
     * Filing status drives BOTH the standard deduction and the bracket table.
     * Switching only the allowance would leave the Single brackets in place and
     * quietly report the wrong federal tax to married crew, which is worse than
     * not offering the choice.
     */
    function setFiling(next: FilingStatus, remember = true) {
      filing = next;
      const profile = FILING[next];

      for (const b of filingPick?.querySelectorAll<HTMLButtonElement>('button[data-filing]') ?? []) {
        b.setAttribute('aria-selected', String(b.dataset.filing === next));
      }
      if (filingName) filingName.textContent = profile.label;

      // The allowance is this status's standard deduction, so it follows.
      values.allow = profile.allowance;
      const allowField = document.querySelector<HTMLInputElement>('input[data-k="allow"]');
      if (allowField) allowField.value = profile.allowance.toFixed(2);

      if (brBody) {
        brBody.innerHTML = profile.brackets
          .map(
            (b) =>
              `<tr><td>${bracketRange(b)}</td><td>${money(b.add)}</td>` +
              `<td>${b.pct}%</td><td>${money(b.sub)}</td></tr>`
          )
          .join('');
      }

      if (remember) {
        try {
          localStorage.setItem(FILING_KEY, next);
        } catch {
          /* choice simply will not persist */
        }
      }
      calc();
    }

    filingPick?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filing]');
      if (!button) return;
      const chosen = button.dataset.filing;
      if (chosen === 'mfj' || chosen === 'hoh' || chosen === 'single') {
        setFiling(chosen);
        // Last step: completing it collapses the stack and leaves the answer.
        stepper.complete(5, FILING[chosen].short);
      }
    });

    /* ---------- Pay calendar ---------- */

    /**
     * The calendar IS step 2 — it answers "which check am I estimating" by
     * tapping a payday, and the secondary question "when does the flying I did
     * get paid" by tapping any other day. One control, so there is nothing for
     * a separate toggle to disagree with.
     */
    const paycal = document.getElementById('paycal');
    const paycalAnswer = document.getElementById('paycalAnswer');

    if (paycal && paycalAnswer) {
      // The server could only bake in the BUILD date. This is the reader's.
      const today = new Date();
      let calYear = today.getFullYear();
      let calMonth = today.getMonth();
      let selected: Date | null = null;

      function drawCalendar() {
        paycal!.innerHTML = renderCalendar({
          year: calYear,
          month: calMonth,
          today,
          selected,
          picked,
        });
      }

      /** Redrawn whenever the picked check changes, not only on a day tap. */
      calendarRedraw = drawCalendar;

      paycal.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;

        const step = target.closest<HTMLButtonElement>('button[data-cal-step]');
        if (step) {
          calMonth += Number(step.dataset.calStep);
          drawCalendar();
          return;
        }

        const dayButton = target.closest<HTMLButtonElement>('button[data-day]');
        if (!dayButton?.dataset.day) return;

        const day = fromKey(dayButton.dataset.day);
        const isPayday = day.getDate() === 5 || day.getDate() === 20;

        if (isPayday) {
          // Picking the check the estimate is for. The day answer goes away —
          // it would be describing a different question than the one just asked.
          selected = null;
          paycalAnswer!.innerHTML = '';
          setCheck(checkOn(day.getFullYear(), day.getMonth(), day.getDate() === 5 ? 5 : 20));
          drawCalendar();
          return;
        }

        // Tapping the selected day again clears it, so the panel can go back
        // to the hint rather than being stuck on one date.
        selected = selected && dayKey(selected) === dayButton.dataset.day ? null : day;

        // A day borrowed from an adjacent month should show that month, or the
        // answer refers to a date the grid is no longer displaying.
        if (selected && selected.getMonth() !== ((calMonth % 12) + 12) % 12) {
          calYear = selected.getFullYear();
          calMonth = selected.getMonth();
        }

        drawCalendar();
        paycalAnswer!.innerHTML = renderDayAnswer(selected);
      });

      drawCalendar();
    }

    /* ---------- Payslip import ---------- */

    /**
     * Only the figures that hold steady between checks are remembered, and
     * only on this device. Earnings are deliberately NOT stored: they change
     * every check, and a shared crew-room computer should not hold someone's
     * pay history.
     */
    const STORE_KEY = 'bsh.paycheck.deductions.v1';
    const START_KEY = 'bsh.paycheck.start.v1';
    const STABLE_KEYS = ['pretax', 'k401', 'posttax', 'dues'] as const;

    const slipInput = document.getElementById('slipFile') as HTMLInputElement | null;
    const slipDrop = document.querySelector<HTMLElement>('[data-slip-drop]');
    const slipStatus = document.getElementById('slipStatus');
    const slipForget = document.getElementById('slipForget') as HTMLButtonElement | null;
    const reconcile = document.getElementById('reconcile');
    const reconcileRows = document.getElementById('reconcileRows');
    const reconcileFor = document.getElementById('reconcileFor');

    function readStore(): Record<string, number> | null {
      try {
        const raw = localStorage.getItem(STORE_KEY);
        return raw ? (JSON.parse(raw) as Record<string, number>) : null;
      } catch {
        return null;
      }
    }

    function writeStore(source: Record<string, number>) {
      const keep: Record<string, number> = {};
      for (const k of STABLE_KEYS) if (typeof source[k] === 'number') keep[k] = source[k];
      try {
        localStorage.setItem(STORE_KEY, JSON.stringify(keep));
        if (slipForget) slipForget.hidden = false;
      } catch {
        /* storage disabled — prefill simply will not persist */
      }
    }

    /** Write values into state and sync any matching input already on screen. */
    function applyValues(incoming: Record<string, number>) {
      for (const [key, value] of Object.entries(incoming)) {
        if (!Number.isFinite(value)) continue;
        values[key] = value;
        const field = document.querySelector<HTMLInputElement>(`input[data-k="${key}"]`);
        if (field) field.value = String(value);
      }
    }

    function setStatus(html: string, tone: 'ok' | 'bad' | '') {
      if (!slipStatus) return;
      slipStatus.className = `statusbox${tone ? ' ' + tone : ''}`;
      slipStatus.innerHTML = html;
      slipStatus.hidden = false;
    }

    const asMoney = (n: number) =>
      (n < 0 ? '-$' : '$') +
      Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    /** Estimate vs. actual, once a payslip has supplied real figures. */
    function showReconcile(actual: { federal: number | null; fica: number | null; net: number | null }, label: string) {
      if (!reconcile || !reconcileRows) return;
      const estimate = currentEstimate();
      const rows: Array<[string, number, number]> = [];
      if (actual.federal !== null) rows.push(['Federal income tax', estimate.fedTax, actual.federal]);
      if (actual.fica !== null) rows.push(['Social Security & Medicare', estimate.fica, actual.fica]);
      if (actual.net !== null) rows.push(['Net pay', estimate.net, actual.net]);

      if (rows.length === 0) {
        reconcile.hidden = true;
        return;
      }

      if (reconcileFor) reconcileFor.textContent = label;
      reconcileRows.innerHTML =
        '<div class="rec-head"><span>Line</span><span class="rec-figs"><span>Estimated</span><span>Actual</span><span>Difference</span></span></div>' +
        rows
          .map(([name, est, act]) => {
            const diff = act - est;
            // Within a dollar is rounding, not a discrepancy worth alarming over.
            const tone = Math.abs(diff) <= 1 ? 'close' : 'off';
            return (
              `<div class="rec-row"><span class="rec-label">${name}</span>` +
              `<span class="rec-figs">` +
              `<span class="rec-est">${asMoney(est)}</span>` +
              `<span class="rec-act">${asMoney(act)}</span>` +
              `<span class="rec-diff ${tone}">${diff >= 0 ? '+' : ''}${asMoney(diff)}</span>` +
              `</span></div>`
            );
          })
          .join('');
      reconcile.hidden = false;
    }

    async function handleFile(file: File) {
      if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
        setStatus("That doesn't look like a PDF. Use the <strong>Payslip to Print</strong> download from Workday.", 'bad');
        return;
      }

      setStatus('Reading your payslip…', '');

      try {
        const [{ parsePayslip }, { mapPayslip }] = await Promise.all([
          import('../../lib/payslip'),
          import('../../lib/payslip-map'),
        ]);

        const slip = await parsePayslip(file);
        const mapped = mapPayslip(slip);

        if (Object.keys(mapped.values).length === 0) {
          setStatus(
            "Couldn't find any pay lines in that PDF. If it opens correctly in a PDF reader, it may be a different report — this expects Workday's <strong>Payslip to Print</strong>.",
            'bad'
          );
          return;
        }

        applyValues(mapped.values);

        // The slip names its own check date, so the estimate can point at the
        // exact check rather than "a 20th". Not marked done: the reader has
        // not answered step 2, they handed over a file.
        const stamped = slip.checkDate ? slip.checkDate.split('/').map(Number) : null;
        if (mapped.check && stamped && stamped.length === 3) {
          setCheck(checkOn(stamped[2], stamped[0] - 1, mapped.check), false);
        } else if (mapped.check) {
          setCheck(nextCheckOfType(new Date(), mapped.check), false);
        } else {
          calc();
        }

        // An import answers steps 1, 3 and 4 outright, so they collapse to
        // what it filled in rather than sitting open and empty-looking.
        stepper.complete(1, slip.checkDate ? `Payslip dated ${slip.checkDate}` : 'Payslip uploaded');
        stepper.complete(3, earnResume());
        stepper.complete(4, dedResume());
        stepper.open(2);

        writeStore(mapped.values);

        const filled = Object.keys(mapped.values).length;
        const when = slip.checkDate ? ` dated ${slip.checkDate}` : '';
        let html = `<strong>Filled ${filled} field${filled === 1 ? '' : 's'}</strong> from your payslip${when}. Check them against the PDF before trusting the result.`;

        const warnings = [...mapped.notes, ...mapped.unmapped.map((u) => `Not used: ${u}`)];
        if (warnings.length) {
          html += '<ul>' + warnings.map((w) => `<li class="warn">${w}</li>`).join('') + '</ul>';
        }
        setStatus(html, 'ok');

        showReconcile(mapped.actual, slip.checkDate ? `check dated ${slip.checkDate}` : '');
      } catch (error) {
        setStatus(
          `Could not read that PDF. ${error instanceof Error ? error.message : 'Unknown error'}`,
          'bad'
        );
      }
    }

    slipInput?.addEventListener('change', () => {
      const file = slipInput.files?.[0];
      if (file) void handleFile(file);
    });

    if (slipDrop) {
      for (const type of ['dragenter', 'dragover'] as const) {
        slipDrop.addEventListener(type, (e) => {
          e.preventDefault();
          slipDrop.classList.add('dragging');
        });
      }
      for (const type of ['dragleave', 'drop'] as const) {
        slipDrop.addEventListener(type, () => slipDrop.classList.remove('dragging'));
      }
      slipDrop.addEventListener('drop', (event) => {
        event.preventDefault();
        const file = (event as DragEvent).dataTransfer?.files?.[0];
        if (file) void handleFile(file);
      });
    }

    slipForget?.addEventListener('click', () => {
      try {
        localStorage.removeItem(STORE_KEY);
      } catch {
        /* nothing to clear */
      }
      slipForget.hidden = true;
      setStatus('Saved deductions cleared from this device.', '');
    });

    /* ---------- How to start ---------- */

    const startPick = document.querySelector<HTMLElement>('[data-start-pick]');
    const slipCard = document.getElementById('slipcard');
    const startHint = document.querySelector<HTMLElement>('[data-start-hint]');

    /**
     * Typing the numbers in is a first-class path. The upload panel stays
     * collapsed until it is chosen, so the PDF never reads as a requirement
     * for crew who do not have one to hand.
     */
    function chooseStart(mode: 'upload' | 'manual', remember = true) {
      if (!startPick) return;

      for (const b of startPick.querySelectorAll<HTMLButtonElement>('button[data-start]')) {
        const picked = b.dataset.start === mode;
        b.setAttribute('aria-pressed', String(picked));
        if (picked && startHint) {
          startHint.textContent = b.dataset.hint ?? '';
          startHint.hidden = false;
        }
      }
      if (slipCard) slipCard.hidden = mode !== 'upload';

      if (remember) {
        try {
          localStorage.setItem(START_KEY, mode);
        } catch {
          /* choice simply will not persist */
        }
      }
    }

    startPick?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-start]');
      if (!button) return;

      const mode = button.dataset.start === 'upload' ? 'upload' : 'manual';
      chooseStart(mode);

      if (mode === 'manual') {
        // Typing is a decision that finishes step 1, so move them on.
        stepper.complete(1, 'Typing the numbers in');
      } else {
        // Uploading is not finished until a file has actually been read — the
        // dropzone lives in this step, so advancing now would hide it.
        stepper.setResume(1, 'Uploading a payslip PDF');
        slipInput?.focus();
      }
    });

    // Restore remembered deductions on load.
    const saved = readStore();
    if (saved && Object.keys(saved).length) {
      applyValues(saved);
      if (slipForget) slipForget.hidden = false;
    }

    // Restore previous choices, without re-saving them.
    try {
      const previous = localStorage.getItem(START_KEY);
      if (previous === 'upload' || previous === 'manual') chooseStart(previous, false);

      const storedFiling = localStorage.getItem(FILING_KEY);
      if (storedFiling === 'single' || storedFiling === 'mfj' || storedFiling === 'hoh') {
        setFiling(storedFiling, false);
      }
    } catch {
      /* no stored preference */
    }

    // Not calc() — the server could only name the BUILD date in the answer
    // header and the check summary. This redraws both against the real today,
    // without marking step 2 answered: nobody has picked a check yet.
    setCheck(nextCheckOfType(new Date(), check), false);
  }
</script>
