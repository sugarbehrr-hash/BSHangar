---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DiscountExplorer from '../../../components/DiscountExplorer.astro';
import Notice from '../../../components/Notice.astro';
import BaseTabs from '../../../components/BaseTabs.astro';
import { bases, venueCount } from '../../../data/bases';

/** One route per base, showing that base's first category. */
export const getStaticPaths = (() =>
  bases.map((base) => ({
    params: { base: base.key },
    props: { base },
  }))) satisfies GetStaticPaths;

const { base } = Astro.props;
const total = base.categories.reduce((n, c) => n + venueCount(c), 0);

/**
 * The description reads the same facts the page shows rather than a second
 * prose copy of them — a search result and the page it opens should not be
 * able to disagree about how the discount works.
 */
const factLine = base.facts
  .map((f) => (f.label ? `${f.label}: ${f.value}` : f.value))
  .join('. ');
---

<BaseLayout
  title={`${base.code} Crew Discounts`}
  description={`${total} crew discounts at ${base.code}, ${base.name}: ${base.categories
    .map((c) => c.label.toLowerCase())
    .join(' and ')}, listed by terminal. ${factLine}.`}
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-body">
        <div class="mh-eyebrow">Crew discounts · {base.name}</div>
        <h1 class="mh-title">{base.code}</h1>
      </div>
      <BaseTabs current={base.key} />
    </div>
  </div>

  <section class="band tight">
    <div class="wrap">
      <DiscountExplorer base={base} />

      <Notice
        tone="info"
        icon="ph-hand-tap"
        spaced
        text={"**Ask before you pay.** Crew discounts aren't posted at every register — show your AA badge and ask. Spotted a new deal or a spot that's closed? Post it in the group and we'll keep the list current."}
      />
    </div>
  </section>
</BaseLayout>
