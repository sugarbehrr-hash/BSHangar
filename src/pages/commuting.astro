---
import GuideArticle from '../components/GuideArticle.astro';
import Icon from '../components/Icon.astro';
import { UNION_REP_PHONE } from '../data/site';
import { commutingGuide as guide } from '../data/guides/commuting';

/**
 * The full Commuting Guide, not a summary — ~2,450 words across 7 sections,
 * rendered through the shared Article template (TOC rail, printable bar,
 * masthead provenance). Same data as /print/commuting-guide/.
 */
---

<GuideArticle
  guide={guide}
  title="Commuting & Non-Rev Guide"
  description="How PSA flight attendants list, fly and report on time: the Commuter Program, your options when a commute fails, boarding-pass documentation, listing by airline, dress guidelines, and a day-of checklist."
  related={[
    { label: 'Your Contract', href: '/contract/' },
    { label: 'Discounts', href: '/crew-discounts/' },
  ]}
>
  <div class="callout">
    <Icon name="ph-warning" />
    <div class="ct">
      <b>This guide assists you and doesn't carry protections.</b> It's plain-language reference
      from the CBA &amp; Commuting Policy. Always confirm current terms with your Inflight
      Supervisor or a union rep. Union Rep Assistance:
      <a href={UNION_REP_PHONE.href}><b>{UNION_REP_PHONE.display}</b></a>.
    </div>
  </div>
</GuideArticle>
