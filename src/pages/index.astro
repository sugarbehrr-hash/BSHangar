---
import CurtainShell from '../components/CurtainShell.astro';
import HomePage from '../components/HomePage.astro';
import Icon from '../components/Icon.astro';
import { SITE, FACEBOOK_GROUP } from '../data/site';
import { PRELAUNCH } from '../data/prelaunch';

/**
 * Site root. While PRELAUNCH is on (see src/data/prelaunch.ts) this is a
 * coming-soon curtain: the TA vote guide links being shared with crew all
 * carry this domain, and the rest of the site is not ready to be seen. The
 * only destinations offered are the two surfaces that ARE public — the vote
 * guide and the Facebook group.
 */
---

{
  PRELAUNCH ? (
    <CurtainShell
      title={`${SITE.name} — Coming Soon`}
      description="The crew hub for PSA flight attendants is under construction. The 2026 TA vote guide is already open."
    >
      <h1>
        Boarding <span class="r">soon.</span>
      </h1>
      <p class="curtain-copy">
        We're building the hangar — non-rev commuting, your contract in plain language, crew
        discounts by base, and gear that lasts. We'll open the doors in the group when it's ready.
      </p>
      <div class="cta">
        <a class="btn btn-red" href="/contract/2026-ta-vote-guide/">
          <Icon name="ph-scroll" /> 2026 TA Vote Guide
        </a>
        <a class="btn btn-ghost" href={FACEBOOK_GROUP} target="_blank" rel="noopener">
          <Icon name="ph-facebook-logo" /> Facebook Group
        </a>
      </div>
    </CurtainShell>
  ) : (
    <HomePage />
  )
}
