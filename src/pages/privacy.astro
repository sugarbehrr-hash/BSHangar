---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FACEBOOK_GROUP } from '../data/site';

/**
 * What the site stores, in plain language.
 *
 * This page exists because of one feature: the per-card feedback strip on the
 * TA vote guide, which accepts free text from anyone who reads it. Collecting
 * writing from the public without saying where it goes is not something to do
 * quietly, and on a document about a ratification vote it matters more than
 * usual — a flight attendant deserves to know before they type that nobody is
 * attaching their name to it and no other reader will ever see it.
 *
 * Kept deliberately short and specific. A page of boilerplate nobody reads
 * would defeat the point.
 */
---

<BaseLayout
  title="Privacy"
  description="What Blue Streak Hangar stores when you send feedback on a guide, what it is used for, and how to take it back."
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-body">
        <div class="mh-eyebrow">Privacy</div>
        <h1 class="mh-title">What we store</h1>
        <p class="mh-sub">
          Short version: your feedback on a card, and nothing that identifies you.
        </p>
      </div>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <div class="textcol">
        <div class="gd-section">
          <div class="gd-block">
            <h3 class="gd-h3">The feedback strip on each card</h3>
            <p class="gd-p">
              Every card in the vote guide has a "Was this clear?" prompt at the bottom. When you
              answer it, we store your answer, whatever you typed in the note box, the base you
              optionally entered, which card it was, which revision of the guide you were reading,
              and the time.
            </p>
            <p class="gd-p">
              We also store a random ID that your browser generates. It is not linked to you, your
              employee number, or anything else — its only job is to make sure one person answering
              the same card twice replaces their earlier answer instead of counting twice, and to
              let you change or withdraw what you said.
            </p>
          </div>

          <div class="gd-block">
            <h3 class="gd-h3">What we do not collect</h3>
            <p class="gd-p">
              No name, no email, no employee or seniority number, no login. We do not run
              advertising, we do not build a profile of you, and we do not sell or share anything
              with anyone. If you type identifying details into the note box, they are stored — so
              please don't.
            </p>
          </div>

          <div class="gd-block">
            <h3 class="gd-h3">Who reads it</h3>
            <p class="gd-p">
              The flight attendants who write and maintain the guide. Notes are never published,
              never shown to other readers, and never attached to a name — there is no comment
              section here by design. We read them to find the cards that are wrong, unclear, or
              missing something, and then we fix those cards.
            </p>
          </div>

          <div class="gd-block">
            <h3 class="gd-h3">Taking it back</h3>
            <p class="gd-p">
              Tap <strong>Undo</strong> on any card you have answered. That marks your response
              withdrawn and it stops counting. If you would rather it were deleted outright, ask in
              the <a href={FACEBOOK_GROUP} rel="noopener">Facebook group</a> and we will remove it.
            </p>
          </div>

          <div class="gd-block">
            <h3 class="gd-h3">The parts that aren't ours</h3>
            <p class="gd-p">
              Feedback is stored with Google Firebase, which is what makes it possible to run this
              on a site with no server of its own. To stop bots flooding the guide with junk, the
              submit step is checked by Google reCAPTCHA, which collects its own device and
              browsing information under
              <a href="https://policies.google.com/privacy" rel="noopener">Google's privacy policy</a>.
              That check only runs when you actually send something — reading the guide triggers
              nothing.
            </p>
            <p class="gd-p">
              The site itself is served by GitHub Pages. Guides you have opened are cached on your
              own device so they still work without a signal, which is also where an unsent note
              waits until you are back online.
            </p>
          </div>
        </div>

        <p class="footnote">
          Questions about any of this? Ask in the
          <a href={FACEBOOK_GROUP} rel="noopener">Blue Streak Hangar group</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
