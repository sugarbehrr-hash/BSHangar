---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import FigureLedger from '../../components/FigureLedger.astro';
import SituationZone from '../../components/SituationZone.astro';
import { UNION_REP_PHONE } from '../../data/site';
import {
  commutingFigures,
  commutingIntro,
  commutingSituations,
  commutingCopy,
  commutingHelp,
} from '../../data/commuting-hub';
import { commutingResources } from '../../data/resources';

/**
 * The Commuting hub, on the same two patterns as /contract/ — and deliberately
 * NOT aligned to it beyond that. Four figures rather than six because only
 * four things are actual program deadlines, and the chips are a timeline
 * rather than § citations because commuting rules mostly aren't CBA sections.
 *
 * The full step-by-step guide stays where it was; this page links to it.
 */
---

<BaseLayout
  title="Commuting & Non-Rev"
  description="Commuting sorted by the moment you need it: the deadlines that keep you inside the Commuter Program — listing, back-ups, cushion and documentation — and what to do when a commute fails, a gate agent questions your dress, or non-rev travel lands on your paycheck."
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-grid">
        <div class="mh-body">
          <div class="mh-eyebrow">{commutingCopy.eyebrow}</div>
          <h1 class="mh-title" set:html={commutingCopy.title} />
          <p class="mh-sub">{commutingCopy.sub}</p>
        </div>

        <aside class="tapanel">
          <span class="flag"><Icon name="ph-warning" /> {commutingHelp.flag}</span>
          <h4>
            {commutingHelp.heading}<br /><span class="r">{commutingHelp.headingAccent}</span>
          </h4>
          {
            commutingHelp.rows.map((row) =>
              'phone' in row && row.phone ? (
                <div class="tarow">
                  <span class="k">{row.k}</span>
                  <a class="v live" href={UNION_REP_PHONE.href}>{UNION_REP_PHONE.display}</a>
                </div>
              ) : (
                <div class="tarow">
                  <span class="k">{row.k}</span>
                  <span class="v">{row.v}</span>
                </div>
              )
            )
          }
          <div class="cta">
            <a class="btn primary sm" href={commutingHelp.ctaHref}>
              <Icon name="ph-list-checks" /> {commutingHelp.ctaLabel}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <span class="kicker">{commutingCopy.figuresKicker}</span>
        <h2 class="h2">{commutingCopy.figuresHeading}</h2>
        <p class="lead">{commutingCopy.figuresLead}</p>
      </div>

      <FigureLedger figures={commutingFigures} intro={commutingIntro} />
    </div>
  </section>

  <section class="band paper">
    <div class="wrap">
      <div class="band-head">
        <span class="kicker">{commutingCopy.situationsKicker}</span>
        <h2 class="h2">{commutingCopy.situationsHeading}</h2>
        <p class="lead">{commutingCopy.situationsLead}</p>
      </div>

      <div class="situations">
        {
          commutingSituations.map((situation) => (
            <SituationZone situation={situation} id={situation.anchor} />
          ))
        }
      </div>

      <div class="actionbar" style="--accent: var(--red-600);">
        <span class="card-badge"><Icon name="ph-headset" /></span>
        <div class="txt">
          <b>{commutingCopy.actionTitle}</b>
          <span>{commutingCopy.actionBody}</span>
        </div>
        <a class="btn primary" href={UNION_REP_PHONE.href}>
          <Icon name="ph-phone-call" /> {UNION_REP_PHONE.display}
        </a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <span class="kicker">{commutingCopy.docsKicker}</span>
        <h2 class="h2">{commutingCopy.docsHeading}</h2>
        <p class="lead">{commutingCopy.docsLead}</p>
      </div>

      <div class="grid two">
        {
          commutingResources.map((res) => (
            <div class="card doc" style={`--accent: ${res.accent};`}>
              <div class="card-head">
                <span class="card-badge sq"><Icon name={res.icon} /></span>
                <div class="card-titles">
                  <h3 class="card-title">{res.title}</h3>
                  <div class="card-sub">{res.format}</div>
                </div>
              </div>
              <p class="card-text">{res.blurb}</p>
              <div class="card-actions">
                {res.links.map((link) => (
                  <a class={`btn ${link.variant} sm`} href={link.href}>
                    <Icon name={link.icon} /> {link.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <p class="art-disclaimer" style="margin-top:24px;">{commutingCopy.disclaimer}</p>
    </div>
  </section>
</BaseLayout>
