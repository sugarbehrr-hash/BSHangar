---
import GuideArticle from '../../components/GuideArticle.astro';
import Icon from '../../components/Icon.astro';
import { UNION_REP_PHONE } from '../../data/site';
import { commutingGuide as guide } from '../../data/guides/commuting';

/**
 * The full Commuting Guide — every word, section by section.
 *
 * /commuting/ is the hub the redesign introduced: the deadlines and the
 * situations, for the moment you're standing at a gate. This is the reference
 * behind it, and the same content the printable renders.
 */
---

<GuideArticle
  guide={guide}
  title="Commuting Guide"
  description="The full Commuter Program reference for PSA flight attendants: listing, back-up flights, what happens when a commute fails, boarding-pass documentation, listing by airline, dress guidelines and a day-of checklist."
  related={[
    { label: 'Commuting overview', href: '/commuting/' },
    { label: 'Your Contract', href: '/contract/' },
  ]}
>
  <div class="callout">
    <Icon name="ph-warning" />
    <div class="ct">
      <b>This guide assists you and doesn't carry protections.</b> It's plain-language reference
      from the CBA &amp; Commuting Policy. Always confirm current terms with your Inflight
      Supervisor or a union rep. Union Rep Assistance:
      <a href={UNION_REP_PHONE.href}><b>{UNION_REP_PHONE.display}</b></a>.
    </div>
  </div>
</GuideArticle>
