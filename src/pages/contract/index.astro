---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import FigureLedger from '../../components/FigureLedger.astro';
import SituationZone from '../../components/SituationZone.astro';
import { UNION_REP_PHONE, DISCLAIMER } from '../../data/site';
import {
  contractFigures,
  contractIntro,
  contractSituations,
  contractCopy,
} from '../../data/contract-hub';
import { contractResources, VOTE_GUIDE } from '../../data/resources';
import { taPanel } from '../../data/contract';

const ta = taPanel[taPanel.phase];

/**
 * The vendored TA guide is surfaced by the masthead panel above, so it is not
 * repeated as a document card — those are the two full-text guides only.
 */
const docs = contractResources.filter((res) => res.kind === 'generated');

/**
 * The Contract hub, rebuilt on the redesign's two patterns.
 *
 * The CBA sorted by section number is unusable in the moment; sorted by "what
 * is happening to me" it is answerable in one tap. So the page is a ledger of
 * the numbers worth carrying, then the situations they come up in — and the
 * full section-by-section text stays in the guides this page links to.
 */
---

<BaseLayout
  title="Your Contract"
  description="The PSA AFA contract sorted by the moment you need it: the numbers worth carrying — scheduled duty, the duty ceiling, rest, guarantee, minimum day pay, short-call and grievance deadlines — and the situations they come up in, each sourced to its CBA section."
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-grid">
        <div class="mh-body">
          <div class="mh-eyebrow">Collective Bargaining Agreement</div>          <h1 class="mh-title">Contractual Knowledge<br />Is Power</h1>
          <p class="mh-sub">{contractCopy.sub}</p>
        </div>

        {
          taPanel.show && (
            <aside class="tapanel">
              <span class="flag">
                <Icon name={ta.flagIcon} /> {ta.flag}
              </span>
              <h4>
                {ta.heading}
                <br />
                <span class="r">{ta.headingAccent}</span>
              </h4>
              {ta.rows.map((row) => (
                <div class="tarow">
                  <span class="k">{row.k}</span>
                  <span class:list={['v', 'live' in row && row.live && 'live']}>{row.v}</span>
                </div>
              ))}
              <div class="cta">
                <a class="btn primary sm" href={VOTE_GUIDE.guide}>
                  <Icon name="ph-book-open" /> {ta.ctaLabel}
                </a>
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <span class="kicker">{contractCopy.figuresKicker}</span>
        <h2 class="h2">{contractCopy.figuresHeading}</h2>
        <p class="lead">{contractCopy.figuresLead}</p>
      </div>

      <FigureLedger figures={contractFigures} intro={contractIntro} />

      <div class="band-head" style="margin-top:46px;">
        <span class="kicker">{contractCopy.situationsKicker}</span>
        <h2 class="h2">{contractCopy.situationsHeading}</h2>
        <p class="lead">{contractCopy.situationsLead}</p>
      </div>

      <div class="situations">
        {contractSituations.map((situation) => <SituationZone situation={situation} />)}
      </div>

      <div class="actionbar" style="--accent: var(--red-600);">
        <span class="card-badge"><Icon name="ph-headset" /></span>
        <div class="txt">
          <b>{contractCopy.actionTitle}</b>
          <span>{contractCopy.actionBody}</span>
        </div>
        <a class="btn primary" href={UNION_REP_PHONE.href}>
          <Icon name="ph-phone-call" /> {UNION_REP_PHONE.display}
        </a>
      </div>

      <div class="band-head" style="margin-top:46px;">
        <span class="kicker">{contractCopy.docsKicker}</span>
        <h2 class="h2">{contractCopy.docsHeading}</h2>
        <p class="lead">{contractCopy.docsLead}</p>
      </div>

      <div class="grid two">
        {
          docs.map((res) => (
            <div class="card doc" style={`--accent: ${res.accent};`}>
              <div class="card-head">
                <span class="card-badge sq"><Icon name={res.icon} /></span>
                <div class="card-titles">
                  <h3 class="card-title">{res.title}</h3>
                  <div class="card-sub">{res.format}</div>
                </div>
              </div>
              <p class="card-text">{res.blurb}</p>
              <div class="card-actions">
                {res.links.map((link) => (
                  <a class={`btn ${link.variant} sm`} href={link.href}>
                    <Icon name={link.icon} /> {link.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <p class="art-disclaimer" style="margin-top:24px;">{DISCLAIMER.contract}</p>
    </div>
  </section>
</BaseLayout>
