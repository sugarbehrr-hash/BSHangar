---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideHero from '../../components/GuideHero.astro';
import GuideBody from '../../components/GuideBody.astro';
import { contractGuide as guide } from '../../data/guides/contract';
---

<BaseLayout title={guide.title} description={guide.intro}>
  <GuideHero guide={guide} pdfHref="/print/contract-field-manual/" />
  <section class="band">
    <div class="wrap">
      <GuideBody guide={guide} />
    </div>
  </section>
</BaseLayout>
