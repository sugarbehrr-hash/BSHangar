---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurtainShell from '../components/CurtainShell.astro';
import Icon from '../components/Icon.astro';
import { NAV } from '../data/site';
import { PRELAUNCH } from '../data/prelaunch';

/**
 * GitHub Pages serves /404.html automatically for unmatched paths, including
 * on a custom domain. build.format is 'directory', so this emits 404/index.html
 * — Pages looks for 404.html at the root, so astro.config keeps this route
 * flat via the redirect handling in Phase 6. Verified against the built output.
 *
 * While PRELAUNCH is on this renders in the curtain shell instead of
 * BaseLayout: the destination list — and BaseLayout's own header nav — would
 * hand every unfinished section to anyone who mistypes a URL.
 */
const destinations = NAV.filter((item) => item.href !== '/');
---

{
  PRELAUNCH ? (
    <CurtainShell
      title="Page not found"
      description="That page doesn't exist. The hangar opens soon."
    >
      <h1>
        Wrong <span class="r">gate.</span>
      </h1>
      <p class="curtain-copy">
        That page doesn't exist, or it isn't open yet — the hangar is still under construction.
      </p>
      <div class="cta">
        <a class="btn primary" href="/"><Icon name="ph-airplane-tilt" /> To the gate</a>
      </div>
    </CurtainShell>
  ) : (
    <BaseLayout
      title="Page not found"
      description="That page doesn't exist. Here's where everything lives in the hangar."
    >
      <div class="masthead">
        <div class="wrap">
          <div class="mh-body">
            <div class="mh-eyebrow">404</div>
            <h1 class="mh-title">Wrong gate.</h1>
            <p class="mh-sub">
              That page doesn't exist, or it moved. Everything in the hangar is one tap away below.
            </p>
          </div>
        </div>
      </div>

      <section class="band">
        <div class="wrap">
          <div class="grid three">
            {
              destinations.map((item) => (
                <a class="card" href={item.href}>
                  <div class="card-head">
                    <span class="card-badge"><Icon name={item.icon} /></span>
                    <div class="card-titles">
                      <h3 class="card-title">{item.label}</h3>
                    </div>
                  </div>
                  <span class="card-go">
                    Go <Icon name="ph-arrow-right" />
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </BaseLayout>
  )
}
