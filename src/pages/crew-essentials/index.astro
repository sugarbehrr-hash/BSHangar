---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { FACEBOOK_GROUP } from '../../data/site';
import { products, countFor } from '../../data/essentials';
import { bagCategories } from '../../data/bags';
import { productCategories, pickCount, priceRange } from '../../data/catalog';

/**
 * The browse page.
 *
 * A worked category is a LINK now, not a card that grew into its ladder in
 * place. The morph was clever and wrong: a ladder is a full page of content —
 * seven picks, a jumpseat and the standard — so cramming it into a grid row
 * meant it could never be linked to, shared, or found by search. Categories
 * are destinations; this page points at them.
 */
const total = countFor('all');
---

<BaseLayout
  title="Crew Essentials"
  description="Gear that survives the schedule: rolling bags at three price levels, packing cubes, compression socks, power banks, uniform care and layover sleep kits — vetted picks from PSA flight attendants."
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-body">
        <div class="mh-eyebrow">Packed &amp; tested by crew</div>
        <h1 class="mh-title">Crew Essentials</h1>
        <p class="mh-sub">
          The gear that actually survives the schedule. These are the picks that come up again and
          again in the group — vetted by FAs, with links to buy.
        </p>
      </div>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <div class="band-head tight">
        <span class="kicker">Worked all the way through</span>
        <h2 class="h2">Compare a whole category</h2>
      </div>

      <div class="catlinks">
        {
          bagCategories.map((category) => (
            <a class="catlink" href={`/crew-essentials/${category.key}/`}>
              <span class="cl-icon">
                <Icon name={category.icon} />
              </span>
              <span class="cl-body">
                <span class="cl-name">{category.label}</span>
                <span class="cl-blurb">{category.blurb}</span>
                <span class="cl-meta">
                  {pickCount(category)} picks · {priceRange(category)}
                </span>
              </span>
              <span class="cl-go">
                <Icon name="ph-arrow-right" />
              </span>
            </a>
          ))
        }
      </div>

      <div class="band-head tight" style="margin-top:36px;">
        <span class="kicker">Single picks</span>
        <h2 class="h2">The rest of the kit</h2>
        <p class="lead">
          Categories we haven't worked all the way through yet — one pick each, for now.
        </p>
      </div>

      <div class="pillbar" id="catbar">
        <div class="pillrail">
          {
            productCategories.map((cat, i) => (
              <button class="pill" type="button" data-cat={cat.key} aria-pressed={i === 0}>
                <Icon name={cat.icon} />
                {cat.label} <span class="count">{countFor(cat.key)}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="toolrow">
        <span class="count-label" id="prodcount" aria-live="polite">
          Showing all {total} picks
        </span>
        <span class="quietbtns">
          <a class="txtbtn" href="/fa-approved/">How the tiers work</a>
          <span class="tdot">·</span>
          <a class="txtbtn" href="#note">How the links work</a>
        </span>
      </div>

      <div class="grid three" id="prodgrid">
        {
          products.map((product) => (
            <div class="card product" data-cat={product.cat}>
              <div class="shot">
                <span class="tagchip">{product.tag}</span>
                <Icon name={product.icon} />
              </div>
              <div class="pbody">
                <h3 class="card-title">{product.title}</h3>
                <p class="card-text">{product.blurb}</p>
                <a class="btn quiet sm" href={product.url} target="_blank" rel="noopener sponsored">
                  <Icon name="ph-amazon-logo" /> View on Amazon
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <div class="notice warn spaced" id="note">
        <Icon name="ph-hand-heart" />
        <div class="nt">
          <b>A quick note.</b> As an Amazon Associate, the Hangar earns from qualifying purchases —
          at no extra cost to you. These are genuine crew picks; buying through these links helps
          keep the group's guides free and up to date. Thank you for the support.
        </div>
      </div>

      <div class="actionbar" style="margin-top:20px; --accent: var(--sky-700);">
        <span class="card-badge"><Icon name="ph-chats-circle" /></span>
        <div class="txt">
          <b>Got a pick the whole hangar should know about?</b>
          <span>Post it in the group — if crew keep recommending it, it lands on this page.</span>
        </div>
        <a class="btn gold" href={FACEBOOK_GROUP} target="_blank" rel="noopener">
          <Icon name="ph-arrow-up-right" /> Open the group
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* The category filter over the single-pick grid.

     The tier-morph FLIP animation that used to live here is gone with the
     cards it animated — a worked category is its own page now. */

  const bar = document.querySelector<HTMLElement>('#catbar');
  const grid = document.querySelector<HTMLElement>('#prodgrid');
  const label = document.querySelector<HTMLElement>('#prodcount');

  if (bar && grid && label) {
    const pills = [...bar.querySelectorAll<HTMLButtonElement>('.pill')];
    const cards = [...grid.querySelectorAll<HTMLElement>('.card.product')];
    const total = cards.length;

    /** The pill's own label, minus its trailing count: "bags & packing". */
    const nameFor = (cat: string) =>
      pills
        .find((pill) => pill.dataset.cat === cat)
        ?.textContent?.trim()
        .replace(/\s+\d+$/, '')
        .toLowerCase() ?? cat;

    const apply = (cat: string) => {
      let shown = 0;
      for (const card of cards) {
        const match = cat === 'all' || card.dataset.cat === cat;
        card.hidden = !match;
        if (match) shown++;
      }
      for (const pill of pills) {
        pill.setAttribute('aria-pressed', String(pill.dataset.cat === cat));
      }
      label.textContent =
        cat === 'all' ? `Showing all ${total} picks` : `Showing ${shown} in ${nameFor(cat)}`;
    };

    for (const pill of pills) {
      pill.addEventListener('click', () => apply(pill.dataset.cat ?? 'all'));
    }
  }
</script>
