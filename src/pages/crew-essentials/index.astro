---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import TierIntro from '../../components/TierIntro.astro';
import TierLadder from '../../components/TierLadder.astro';
import JumpseatSlot from '../../components/JumpseatSlot.astro';
import { FACEBOOK_GROUP } from '../../data/site';
import { products } from '../../data/essentials';
import { bagCategories } from '../../data/bags';
import { pickCount, navMeta } from '../../data/catalog';

/**
 * Crew Essentials — ONE page.
 *
 * Every category is a row in the category nav (.catnav — a dropdown up to
 * 1400px, a permanent side rail above it). Picking one swaps its whole
 * content into this page in place: a worked category shows its jumpseat and
 * three-tier ladder, one we have not worked through yet shows its single
 * pick. No navigation, no cards that unfold, no route per category.
 *
 * Two earlier attempts are worth not repeating. A card that grew into its
 * ladder inside a grid row could not be linked to or found by search. A route
 * per category fixed that and made the reader juggle pages to compare, which
 * is worse — comparing is the whole job of this page.
 *
 * Every panel is rendered server-side and hidden; the script only flips which
 * one is visible. That keeps all of it in the HTML for search and for a reader
 * with no JavaScript, who gets the first category rather than a dead page.
 */
const tabs = [
  ...bagCategories.map((category) => ({
    key: category.key,
    label: category.label,
    icon: category.icon,
    isLadder: true,
    rowMeta: `${pickCount(category)} picks`,
    fullMeta: navMeta(category),
    category,
    product: null,
  })),
  ...products.map((product) => ({
    key: product.title.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    label: product.title,
    icon: product.icon,
    isLadder: false,
    rowMeta: undefined,
    fullMeta: 'One pick · not a full ladder yet',
    category: null,
    product,
  })),
];
---

<BaseLayout
  title="Crew Essentials"
  description="Gear that survives the schedule: rolling bags at three price levels, packing cubes, compression socks, power banks, uniform care and layover sleep kits — vetted picks from PSA flight attendants."
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-body">
        <div class="mh-eyebrow">Packed &amp; tested by crew</div>
        <h1 class="mh-title">Crew Essentials</h1>
        {/* Provenance, which on a page recommending things to buy is the line
            doing the most work — and the only part of the old paragraph that
            wasn't already visible in the grid below. */}
        <p class="mh-sub">
          The picks that come up again and again in the group, vetted by FAs.
        </p>
      </div>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <div class="ess-layout" id="essLayout">
        <CategoryNav tabs={tabs} />
        <div class="catpanels">
          {
            tabs.map((tab, i) => (
              <div
                class="catpanel"
                id={`panel-${tab.key}`}
                role="tabpanel"
                aria-labelledby={`tab-${tab.key}`}
                data-panel={tab.key}
                data-meta={tab.fullMeta}
                hidden={i !== 0}
              >
                {tab.category ? (
                  <>
                    <div class="jumprow">
                      {/* Above the ladder — Cole's call. It is the pick crew ask about most. */}
                      <JumpseatSlot category={tab.category} />
                      <TierIntro />
                    </div>
                    <TierLadder category={tab.category} />
                    <p class="ladder-note">{tab.category.note}</p>
                  </>
                ) : (
                  <>
                    <div class="solopick">
                      <span class="sp-icon">
                        <Icon name={tab.product!.icon} />
                      </span>
                      <div class="sp-body">
                        <span class="sp-tag">{tab.product!.tag}</span>
                        <h2 class="sp-name">{tab.product!.title}</h2>
                        <p class="sp-blurb">{tab.product!.blurb}</p>
                        <a
                          class="btn quiet sm"
                          href={tab.product!.url}
                          target="_blank"
                          rel="noopener sponsored"
                        >
                          <Icon name="ph-amazon-logo" /> View on Amazon
                        </a>
                      </div>
                    </div>
                    <p class="ladder-note">
                      We haven't worked this category all the way through yet — this is one pick, not a
                      reviewed ladder. When crew have flown enough of them it gets the same three price
                      levels and a named jumpseat pick, like Spinners and Rollaboards.
                    </p>
                  </>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <div class="notice warn spaced" id="note">
        <Icon name="ph-hand-heart" />
        <div class="nt">
          <b>A quick note.</b> As an Amazon Associate, the Hangar earns from qualifying purchases —
          at no extra cost to you. These are genuine crew picks; buying through these links helps
          keep the group's guides free and up to date. Thank you for the support.
        </div>
      </div>

      <div class="actionbar" style="margin-top:20px; --accent: var(--sky-700);">
        <span class="card-badge"><Icon name="ph-chats-circle" /></span>
        <div class="txt">
          <b>Got a pick the whole hangar should know about?</b>
          <span>Post it in the group — if crew keep recommending it, it lands on this page.</span>
        </div>
        <a class="btn gold" href={FACEBOOK_GROUP} target="_blank" rel="noopener">
          <Icon name="ph-arrow-up-right" /> Open the group
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* Category switching, in place. Every panel is already in the HTML — this
     only decides which one is shown, so nothing is fetched and nothing
     navigates.

     The hash is written so a category can still be linked to and shared. It is
     set with replaceState rather than location.hash: assigning the hash scrolls
     the panel under the sticky header, and it would also stack a history entry
     per row, turning the back button into an undo of clicks.

     The nav itself is a dropdown everywhere except very wide viewports, where
     CSS turns the same list into a permanent side rail (see the CATEGORY NAV
     block in system.css). On the two reviewed ladders, the nav has a real
     neighbour — the "Same bar, three prices" card — to sit beside instead of
     leaving open space, so the same nav DOM node is moved into that panel's
     own .jumprow while it's active, and returns to its default slot above the
     panels everywhere else. */

  const bar = document.querySelector<HTMLElement>('#catbar');

  if (bar) {
    const trigger = document.querySelector<HTMLButtonElement>('#cnTrigger');
    const rows = [...bar.querySelectorAll<HTMLButtonElement>('.cn-row')];
    const panels = [...document.querySelectorAll<HTMLElement>('.catpanel')];
    const triggerIcon = document.querySelector<HTMLElement>('#cnTriggerIcon');
    const triggerName = document.querySelector<HTMLElement>('#cnTriggerName');
    const triggerMeta = document.querySelector<HTMLElement>('#cnTriggerMeta');

    const closeList = () => {
      bar.removeAttribute('data-open');
      trigger?.setAttribute('aria-expanded', 'false');
    };
    const openList = () => {
      bar.setAttribute('data-open', '1');
      trigger?.setAttribute('aria-expanded', 'true');
    };

    const homeParent = bar.parentNode!;
    const homeNext = bar.nextSibling;
    const jumprowSlots: Record<string, HTMLElement | null> = {};
    for (const row of rows) {
      const key = row.dataset.tab ?? '';
      jumprowSlots[key] = document.querySelector<HTMLElement>(`#panel-${key} .jumprow`);
    }
    const placeNav = (key: string) => {
      const slot = jumprowSlots[key];
      if (slot) slot.insertBefore(bar, slot.firstChild);
      else homeParent.insertBefore(bar, homeNext);
    };

    const show = (key: string, pushHash = true) => {
      const row = rows.find((r) => r.dataset.tab === key);
      if (!row) return;

      for (const r of rows) r.setAttribute('aria-selected', String(r === row));
      for (const panel of panels) panel.hidden = panel.dataset.panel !== key;
      const panel = panels.find((p) => p.dataset.panel === key);

      const icon = row.querySelector('i');
      if (triggerIcon && icon) triggerIcon.className = icon.className;
      const name = row.querySelector('.cn-name');
      if (triggerName && name) triggerName.textContent = name.textContent;
      if (triggerMeta) triggerMeta.textContent = panel?.dataset.meta ?? '';

      placeNav(key);
      closeList();
      if (pushHash) history.replaceState(null, '', `#${key}`);

      // Keep the chosen row in view when the dropdown is open on a phone.
      row.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: 'smooth' });
    };

    trigger?.addEventListener('click', () => {
      if (bar.hasAttribute('data-open')) closeList();
      else openList();
    });
    document.addEventListener('click', (e) => {
      if (!bar.contains(e.target as Node)) closeList();
    });
    for (const row of rows) {
      row.addEventListener('click', () => show(row.dataset.tab ?? ''));
    }

    const fromHash = decodeURIComponent(location.hash.slice(1));
    show(rows.some((r) => r.dataset.tab === fromHash) ? fromHash : (rows[0]?.dataset.tab ?? ''), false);
  }
</script>
