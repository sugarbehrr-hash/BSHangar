---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TierLadder from '../../components/TierLadder.astro';
import JumpseatSlot from '../../components/JumpseatSlot.astro';
import { FACEBOOK_GROUP } from '../../data/site';
import { products, countFor } from '../../data/essentials';
import { bagCategories } from '../../data/bags';
import {
  productCategories,
  TIERS,
  TIER_ORDER,
  allStamped,
  coverFor,
  pickCount,
  priceRange,
} from '../../data/catalog';

/**
 * The browse page. Most picks are one tile; a category the group has worked
 * all the way through is one tile too, which grows into its three-tier ladder
 * in place rather than sending the reader somewhere else to compare.
 */
const total = countFor('all');

/** "Economy, Main Cabin & First Class" — from the tier vocabulary, not typed. */
const tierList = TIER_ORDER.map((tier) => TIERS[tier].label);
const tierNames = `${tierList.slice(0, -1).join(', ')} & ${tierList.at(-1)}`;
---

<BaseLayout
  title="Crew Essentials"
  description="Gear that survives the schedule: rolling bags at three price levels, packing cubes, compression socks, power banks, uniform care and layover sleep kits — vetted picks from PSA flight attendants."
>
  <div class="masthead">
    <div class="wrap">
      <div class="mh-body">
        <div class="mh-eyebrow">Packed &amp; tested by crew</div>
        <h1 class="mh-title">Crew Essentials</h1>
        <p class="mh-sub">
          The gear that actually survives the schedule. These are the picks that come up again and
          again in the group — vetted by FAs, with links to buy.
        </p>
      </div>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <div class="pillbar" id="catbar">
        <div class="pillrail">
          {
            productCategories.map((cat, i) => (
              <button class="pill" type="button" data-cat={cat.key} aria-pressed={i === 0}>
                <Icon name={cat.icon} />
                {cat.label} <span class="count">{countFor(cat.key)}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="toolrow">
        <span class="count-label" id="prodcount" aria-live="polite">
          Showing all {total} picks
        </span>
        <span class="quietbtns">
          <a class="txtbtn" href="/fa-approved/">How the tiers work</a>
          <span class="tdot">·</span>
          <a class="txtbtn" href="#note">How the links work</a>
        </span>
      </div>

      <div class="grid three" id="prodgrid">
        {
          bagCategories.map((category) => {
            const cover = coverFor(category);

            return (
              <div class="card product tiermorph" data-cat={category.cat}>
                <div
                  class="tm-face"
                  role="button"
                  tabindex="0"
                  aria-expanded="false"
                  aria-label={`${category.label} — see every pick`}
                >
                  <div class="shot">
                    {cover ? (
                      <img src={cover.image} alt={cover.alt} />
                    ) : (
                      <Icon name={category.icon} />
                    )}
                    <span class="tagchip">{pickCount(category)} picks</span>
                    {/* Only when every pick on the ladder has cleared the gate.
                        A category cannot be flown 90 days; stamping one that
                        still holds a provisional pick claims what it can't. */}
                    {
                      allStamped(category) && (
                        <span class="stampmini">
                          <span class="t">FA Approved</span>
                          <span class="s">Blue Streak Hangar</span>
                        </span>
                      )
                    }
                  </div>
                  <div class="pbody">
                    <h3 class="card-title">{category.label}</h3>
                    <p class="card-text">{category.blurb}</p>
                    <span class="card-go">
                      See every pick <Icon name="ph-arrow-right" />
                    </span>
                  </div>
                </div>

                <div class="tm-full">
                  {/* The label is hidden under 700px, where the icon stands alone,
                      so the name is stated rather than inferred from the text. */}
                  <button
                    class="tierfold-head"
                    type="button"
                    data-tm-close
                    aria-label="Fold it back up"
                  >
                    <div class="tf-main">
                      <span class="tf-kicker">Same bar, three prices</span>
                      <h3 class="tf-title">{category.label}</h3>
                      <div class="tf-sub">{priceRange(category)} · {tierNames}</div>
                    </div>
                    <span class="tf-cta">
                      <span>Fold it back up</span> <Icon name="ph-arrows-in-simple" weight="bold" />
                    </span>
                  </button>

                  <TierLadder category={category} compact />

                  <div class="tf-jump">
                    <JumpseatSlot category={category} />
                  </div>

                  <p class="tf-note">{category.provisionalNote}</p>
                </div>
              </div>
            );
          })
        }

        {
          products.map((product) => (
            <div class="card product" data-cat={product.cat}>
              <div class="shot">
                <span class="tagchip">{product.tag}</span>
                <Icon name={product.icon} />
              </div>
              <div class="pbody">
                <h3 class="card-title">{product.title}</h3>
                <p class="card-text">{product.blurb}</p>
                <a class="btn quiet sm" href={product.url} target="_blank" rel="noopener sponsored">
                  <Icon name="ph-amazon-logo" /> View on Amazon
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <div class="notice warn spaced" id="note">
        <Icon name="ph-hand-heart" />
        <div class="nt">
          <b>A quick note.</b> As an Amazon Associate, the Hangar earns from qualifying purchases —
          at no extra cost to you. These are genuine crew picks; buying through these links helps
          keep the group's guides free and up to date. Thank you for the support.
        </div>
      </div>

      <div class="actionbar" style="margin-top:20px; --accent: var(--sky-700);">
        <span class="card-badge"><Icon name="ph-chats-circle" /></span>
        <div class="txt">
          <b>Got a pick the whole hangar should know about?</b>
          <span>Post it in the group — if crew keep recommending it, it lands on this page.</span>
        </div>
        <a class="btn gold" href={FACEBOOK_GROUP} target="_blank" rel="noopener">
          <Icon name="ph-arrow-up-right" /> Open the group
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* Two behaviours over the same grid: the category filter, and the tier card
     that grows from one tile to the full row. */

  const bar = document.querySelector<HTMLElement>('#catbar');
  const grid = document.querySelector<HTMLElement>('#prodgrid');
  const label = document.querySelector<HTMLElement>('#prodcount');

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bar && grid && label) {
    const pills = [...bar.querySelectorAll<HTMLButtonElement>('.pill')];
    const cards = [...grid.querySelectorAll<HTMLElement>('.card.product')];
    const total = cards.length;

    /** The pill's own label, minus its trailing count: "bags & packing". */
    const nameFor = (cat: string) =>
      pills
        .find((pill) => pill.dataset.cat === cat)
        ?.textContent?.trim()
        .replace(/\s+\d+$/, '')
        .toLowerCase() ?? cat;

    const apply = (cat: string) => {
      let shown = 0;
      for (const card of cards) {
        const match = cat === 'all' || card.dataset.cat === cat;
        card.hidden = !match;
        if (match) shown++;
      }
      for (const pill of pills) {
        pill.setAttribute('aria-pressed', String(pill.dataset.cat === cat));
      }
      label.textContent =
        cat === 'all'
          ? `Showing all ${total} picks`
          : `Showing ${shown} in ${nameFor(cat)}`;
    };

    for (const pill of pills) {
      pill.addEventListener('click', () => apply(pill.dataset.cat ?? 'all'));
    }
  }

  /* ---------- TIER MORPH ----------
     Toggling .open IS the layout change; everything below only animates it.
     FLIP: measure every card before and after, then play each one from its old
     box to its new box as a transform — the growing card as translate + scale,
     its displaced neighbours as a plain translate. */

  /** Clears the sticky topbar. Same value as .step's scroll-margin-top. */
  const TOPBAR_OFFSET = 84;
  const MORPH_MS = 500;

  for (const morph of document.querySelectorAll<HTMLElement>('.tiermorph')) {
    const face = morph.querySelector<HTMLElement>('.tm-face');
    const close = morph.querySelector<HTMLElement>('[data-tm-close]');
    if (!grid || !face || !close) continue;

    const setOpen = (open: boolean) => {
      // The control that was activated is about to be display:none, so a
      // keyboard user would be dropped back to the top of the document.
      const carriedFocus =
        document.activeElement === face || document.activeElement === close;

      const items = [...grid.children] as HTMLElement[];
      const before = new Map(items.map((item) => [item, item.getBoundingClientRect()]));

      morph.classList.toggle('open', open);
      face.setAttribute('aria-expanded', String(open));
      if (carriedFocus) (open ? close : face).focus();

      // Taken before any transform is applied, so these are real layout boxes.
      const after = new Map(items.map((item) => [item, item.getBoundingClientRect()]));

      if (open) {
        const top = (after.get(morph)?.top ?? 0) + window.scrollY - TOPBAR_OFFSET;
        window.scrollTo({ top: Math.max(0, top), behavior: reduceMotion() ? 'auto' : 'smooth' });
      }

      if (reduceMotion()) return;

      const moved: HTMLElement[] = [];
      for (const item of items) {
        const first = before.get(item);
        const last = after.get(item);
        if (!first || !last || !first.width || !last.width) continue;

        const dx = first.left - last.left;
        const dy = first.top - last.top;

        if (item === morph) {
          item.style.transformOrigin = 'top left';
          item.style.transition = 'none';
          item.style.transform =
            `translate(${dx}px, ${dy}px) ` +
            `scale(${first.width / last.width}, ${first.height / last.height})`;
          moved.push(item);
        } else if (dx || dy) {
          item.style.transition = 'none';
          item.style.transform = `translate(${dx}px, ${dy}px)`;
          moved.push(item);
        }
      }

      // Forcing layout commits the transforms above as the animation's first
      // frame, so releasing them on the very next line animates rather than
      // jumping. Deliberately NOT deferred to requestAnimationFrame: rAF does
      // not fire in a background tab, and a card that is toggled and then
      // backgrounded would keep the scale forever.
      grid.getBoundingClientRect();

      for (const item of moved) {
        item.style.transition = `transform ${MORPH_MS}ms var(--ease-out)`;
        item.style.transform = '';
      }

      window.setTimeout(() => {
        for (const item of moved) {
          item.style.transition = '';
          item.style.transformOrigin = '';
        }
      }, MORPH_MS + 60);
    };

    face.addEventListener('click', () => setOpen(true));
    face.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      setOpen(true);
    });
    close.addEventListener('click', () => setOpen(false));
  }
</script>
