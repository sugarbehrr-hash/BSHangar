---
import '../../styles/global.css';
import '../../inbox/inbox.css';

/**
 * The maintainer inbox — reader feedback on the vote guide, ranked worst-first.
 *
 * NOT BaseLayout, on purpose. That shell renders the site header, footer and
 * mobile nav unconditionally and derives a required OG card from the path, none
 * of which belong on a tool two people sign into. It also keys `noindex` to the
 * global PRELAUNCH flag, so inheriting it would quietly publish this page at
 * launch; the tag below is unconditional instead.
 *
 * Nothing here is a secret. The page renders empty and every byte of feedback
 * comes from Firestore, which refuses to hand any of it over to anyone outside
 * the allowlist in firestore.rules. That file is the access control; this is
 * just the reading surface.
 *
 * The card itself is not ours to render twice. assessment.data.js,
 * assessment-charts.js and card-render.js are the SAME vendored files the
 * guide loads (see public/contract/2026-ta-vote-guide/index.html) — loaded
 * here the same way, as plain blocking scripts, so window.VoteCard.changeCard()
 * produces the exact card a reader saw. See src/inbox/cardData.js.
 */

/**
 * Documents with a feedback layer. One today. A second is one line here —
 * the collection keys on `doc`, so nothing else has to change.
 */
const DOCS = {
  '2026-ta-vote-guide': { title: '2026 TA Vote Guide' },
};

const documentId = '2026-ta-vote-guide';

const payload = JSON.stringify({ doc: documentId, title: DOCS[documentId].title }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reader feedback — Blue Streak Hangar</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0F1E3D" />
    <link rel="stylesheet" href="/contract/_assets/styles.css" />
  </head>

  <body>
    <main id="ib-root"></main>

    <noscript>
      <p class="ib-gate-note">
        This page needs JavaScript — it reads the feedback database directly from your browser.
      </p>
    </noscript>

    <script type="application/json" id="ib-data" set:html={payload}></script>

    <!-- The guide's own data + renderer, loaded the same way the guide loads them —
         classic blocking scripts, in dependency order, ahead of the module script
         below so window.ASSESSMENT / AssessmentChart / VoteCard are ready by the
         time mountInbox() runs. -->
    <script is:inline src="/contract/_assets/assessment.data.js"></script>
    <script is:inline src="/contract/_assets/assessment-charts.js"></script>
    <script is:inline src="/contract/_assets/card-render.js"></script>

    <script>
      import { mountInbox } from '../../inbox/mount.js';

      mountInbox(document.getElementById('ib-root'));
    </script>
  </body>
</html>
